import re


ERR1 = 'Cast removed const qualification from %1'
ERR2 = 'Cast removed volatile qualification from %1'
ERR3 = 'Cast removed _Atomic qualification from %1'

CAST_TYPE_WORDS = {'const', 'volatile', 'restrict', '_Atomic', 'signed', 'unsigned', 'char', 'short', 'int', 'long', 'float', 'double', 'void', '_Bool', 'bool', 'struct', 'union', 'enum', '*'}


def ids():
    return ('MISRA08_5-2-5', 'MISRA12_11.8', 'A5-2-3', 'CPP_T021', 'MISRA23_8.2.3', 'MISRA23_11.8', 'MISRA25_11.8', 'MISRA04_11.5')


