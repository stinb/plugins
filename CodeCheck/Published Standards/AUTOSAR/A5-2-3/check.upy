<p><b>Example</b></p>
<pre><code language="C++">         uint16_t          x;
         uint16_t * const  cpi = &x;   /* const pointer               */
         uint16_t * const *pcpi;       /* pointer to const pointer    */
         uint16_t *       *ppi;
   const uint16_t         *pci;        /* pointer to const            */
volatile uint16_t         *pvi;        /* pointer to volatile         */
         uint16_t         *pi;

pi = cpi;                              /* Compliant - no conversion
                                                   no cast required   */

pi  = (uint16_t *)pci;                 /* Not compliant               */
pi  = (uint16_t *)pvi;                 /* Not compliant               */
ppi = (uint16_t * *)pcpi;              /* Not compliant               */
</code></pre>''',
    }[id]


def test_language(language):
    return language == 'C++'


def test_entity(file):
    return True


def test_global():
    return False


def define_options(check):
    atomic = False
    if check.id() in ('MISRA23_11.8', 'MISRA25_11.8'):
        atomic = True
    check.option().checkbox('atomic', 'Check if _Atomic was removed.', atomic)


def on_macro(ref, on_scope=False):
    lexer = ref.file().lexer(lookup_ents=False)
    lex = lexer.lexeme(ref.line(), ref.column())
    ref_ent = ref.scope() if on_scope else ref.ent()

    return lex.text() != ref_ent.name()


def get_utype(ent):
    return str(ent.freetext("UnderlyingType"))


def get_matching_close(open_lex):
    depth = 0
    lex = open_lex

    while lex:
        if lex.text() in {'(', '['}:
            depth += 1
        elif lex.text() in {')', ']'}:
            depth -= 1

            if not depth:
                return lex

        lex = lex.next(True, True)


def get_cast_type(open_lex):
    # The type of a C-style pointer cast starting at open_lex, else None
    prev_lex = open_lex.previous(True, True)

    # a call or sizeof, not a cast
    if prev_lex and (prev_lex.token() == 'Identifier' or prev_lex.text() == 'sizeof'):
        return None

    words = []
    lex = open_lex.next(True, True)

    while lex and lex.text() != ')':
        lex_ent = lex.ent()

        if lex.text() in CAST_TYPE_WORDS:
            words.append(str(lex.text()))
        elif lex_ent and lex_ent.kind().check('Namespace') and lex.next(True, True).text() == '::':
            lex = lex.next(True, True)
        elif lex_ent and lex_ent.kind().check('Typedef'):
            words.append(get_utype(lex_ent))
        elif lex_ent and lex_ent.kind().check('Type'):
            words.append(str(lex.text()))
        else:
            return None

        lex = lex.next(True, True)

    type_text = ' '.join(words)

    return type_text if lex and ('*' in type_text) else None


def deref_type(type_text):
    if not type_text:
        return None

    if re.search(r'\[[^\]]*\]$', type_text):
        return re.sub(r'\s*\[[^\]]*\]$', '', type_text)

    if '*' in type_text:
        return type_text[:type_text.rindex('*')].rstrip()

    return None


def apply_postfix(type_text, lex):
    # Apply subscripts and member accesses that follow an operand
    while type_text and lex:
        if lex.text() == '[':
            type_text = deref_type(type_text)
            lex = get_matching_close(lex)
        elif lex.text() in {'.', '->'} and lex.next(True, True).ent():
            lex = lex.next(True, True)
            type_text = get_utype(lex.ent())
        else:
            break

        lex = lex.next(True, True) if lex else None

    return type_text


def get_expr_type(lex):
    # The type of the operand starting at lex, else None when unknown
    if not lex:
        return None

    if lex.text() == '&':
        value_type = get_expr_type(lex.next(True, True))

        return value_type + ' *' if value_type else None

    if lex.text() == '*':
        return deref_type(get_expr_type(lex.next(True, True)))

    if lex.text() == '(':
        # a cast applies to the whole following operand, so its type is final
        cast_type = get_cast_type(lex)

        if cast_type:
            return cast_type

        close_lex = get_matching_close(lex)

        if not close_lex:
            return None

        return apply_postfix(get_expr_type(lex.next(True, True)), close_lex.next(True, True))

    if lex.ent() and lex.ent().kind().check('Object, Parameter'):
        return apply_postfix(get_utype(lex.ent()), lex.next(True, True))

    return None


def get_pointee_quals(type_text):
    # Qualifiers of the type a pointer of type_text points to
    pointer_text = re.sub(r'\[[^\]]*\]', '*', type_text)

    if '*' not in pointer_text:
        return set()

    pointee_segment = pointer_text.split('*')[-2]

    return set(pointee_segment.split()) & {'const', 'volatile'}


def get_operand_ent(lex):
    # The first object in the operand, which names it in the violation
    depth = 0

    while lex:
        if lex.text() in {'(', '['}:
            depth += 1
        elif lex.text() in {')', ']'}:
            depth -= 1
        elif lex.ent() and lex.ent().kind().check('Object, Parameter'):
            # name the member that is cast, not the object it belongs to
            while lex.next(True, True) and lex.next(True, True).text() in {'.', '->'} and lex.next(True, True).next(True, True).ent():
                lex = lex.next(True, True).next(True, True)

            return lex.ent()

        if depth <= 0 and lex.text() not in {'&', '*', '(', '.', '->'} and lex.token() != 'Identifier':
            return None

        lex = lex.next(True, True)


def check(check, file):
    lexer = None
    reported = set()

    # Cast on the right side of =
    for toRef in file.filerefs('Assignby Ptr ~Indirect', '~Function'):
        fromEnt = toRef.scope()
        toEnt = toRef.ent()

        if not fromEnt or not toEnt or on_macro(toRef, True):
            continue

        # Ensure that ent.type isn't None
        fromType = get_utype(fromEnt)
        toType = get_utype(toEnt)

        # Ignore any types that start with typeof (
        if re.search(r'^typeof \(.*', fromType) or re.search(r'^typeof \(.*', toType):
            continue

        # See if const is removed
        removedConst = False
        # const is removed from the beginning of the type
        if re.search(r'^const.*', fromType) and re.search(r'^const.*', toType):
            pass
        elif re.search(r'^const.*', fromType) and not re.search(r'^const.*', toType):
            removedConst = True
        # *const is removed from the type
        elif re.search(r'^.*\*const\b', fromType) and not re.search(r'^.*\*const\b', toType):
            removedConst = True

        # See if volatile is removed from the beginning or end
        removedVolatile = False
        if re.search(r'^volatile .*', fromType) or re.search(r'^const volatile .*', fromType):
            if not re.search(r'^volatile .*', toType) and not re.search(r'^const volatile .*', toType):
                removedVolatile = True

        # See if _Atomic is removed
        if check.option().lookup('atomic') and re.search(r'_Atomic', fromType) and not re.search(r'_Atomic', toType):
            check.violation(toEnt, file, toRef.line(),
                            toRef.column(), ERR3, fromEnt.name())

        # Get the lexeme
        if not lexer:
            lexer = file.lexer(lookup_ents=False)
        lexeme = lexer.lexeme(toRef.line(), toRef.column())

        # See if there was a cast
        cast = False
        while lexeme and lexeme.text() not in {';', '=', '{', ','}:
            if lexeme.text() in {'const_cast', ')'}:
                cast = True
                break
            lexeme = lexeme.previous(True, True)

        if cast:
            if removedConst:
                check.violation(toEnt, file, toRef.line(),
                                toRef.column(), ERR1, fromEnt.name())
                reported.add((toRef.line(), fromEnt.id(), ERR1))
            if removedVolatile:
                check.violation(toEnt, file, toRef.line(),
                                toRef.column(), ERR2, fromEnt.name())
                reported.add((toRef.line(), fromEnt.id(), ERR2))

    # Cast on the left side of =
    for ref in file.filerefs('Deref Set'):
        ent = ref.ent()
        if not ent or on_macro(ref):
            continue

        # Starts with const
        if re.search(r'^const\b', get_utype(ent)):

            # Get the lexeme
            if not lexer:
                lexer = file.lexer()
            lexeme = lexer.lexeme(ref.line(), ref.column())

            # See if there was a cast
            while lexeme and lexeme.text() != ';':
                if lexeme.text() == 'const_cast':
                    check.violation(ent, file, ref.line(),
                                    ref.column(), ERR1, ent.name())
                    break
                lexeme = lexeme.previous(
                    ignore_whitespace=True, ignore_comments=True)

    # C-style casts whose result is not assigned to a pointer, such as one
    # dereferenced, passed to a function, or nested in another cast
    lexer = file.lexer()
    lexeme = lexer.first()

    while lexeme:
        if lexeme.text() == '(':
            cast_type = get_cast_type(lexeme)
            close_lex = get_matching_close(lexeme) if cast_type else None
            operand_lex = close_lex.next(True, True) if close_lex else None
            operand_type = get_expr_type(operand_lex)
            operand_ent = get_operand_ent(operand_lex)

            if operand_type and operand_ent:
                removed_quals = get_pointee_quals(operand_type) - get_pointee_quals(cast_type)

                for qual, err in (('const', ERR1), ('volatile', ERR2)):
                    if (qual in removed_quals) and ((lexeme.line_begin(), operand_ent.id(), err) not in reported):
                        check.violation(operand_ent, file, lexeme.line_begin(), lexeme.column_begin(), err, operand_ent.name())
                        reported.add((lexeme.line_begin(), operand_ent.id(), err))

        lexeme = lexeme.next(True, True)
