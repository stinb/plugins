import re


ERR1 = 'A switch statement shall be a well-formed switch statement'

# The MISRA C grammar only allows break; to end a switch-clause
C_IDS = {'MISRA04_15', 'MISRA12_16.1', 'MISRA23_16.1', 'MISRA25_16.1'}
CPP23_IDS = {'MISRA23_9.4.2'}
TERMINATOR_CHOICES = [
    'break',
    'break or throw',
    'break, throw, return, goto, continue, exit or abort',
]


