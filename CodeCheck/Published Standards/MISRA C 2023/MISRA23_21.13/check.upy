# This script is designed to run with Understand - CodeCheck
# Written by Jason Quinn
# 11-10-2025
import re
import Modules
from Modules import cParseIntLiteral

ERR1 = "Argument to <ctype.h> function was not an unsigned char or the value EOF"

UNSIGNED_CHAR_TYPES = {'unsigned char', 'uint8_t', 'std::uint8_t'}

CTYPE_FUNCS = {
    "isalnum", "isalpha", "isblank", "iscntrl", "isdigit", "isgraph",
    "islower", "isprint", "ispunct", "isspace", "isupper", "isxdigit",
    "tolower", "toupper"
}

def ids():
    return ('MISRA23_21.13', 'CPP_L036', 'MISRA25_21.13')

def name(id):
    return {
        'MISRA23_21.13': 'Published Standards/MISRA C 2023/' + """\
21.13 Any value passed to a function in <ctype.h> shall be representable as an \
unsigned char or be the value EOF""",
        'CPP_L036': """\
All Checks/Language Specific/C and C++/Libraries/\
Any value passed to a function in <ctype.h> shall be representable as an \
unsigned char or be the value EOF""",
        'MISRA25_21.13': 'Published Standards/MISRA C 2025/21.13 Any value passed to a function in <ctype.h> shall be representable as an unsigned char or be the value EOF',
    }[id]

def tags(id):
    return {
        'MISRA23_21.13': [
            'Language: C',
            'Language: C++',
            'Standard: MISRA C 2023',
            'Category: Mandatory',
            'Libraries',
        ],
        'CPP_L036': [
            'Language: C',
            'Language: C++',
            'Libraries',
        ],
        'MISRA25_21.13': [
            'Language: C',
            'Standard: MISRA C 2025',
            'Category: Mandatory',
            'Libraries',
        ],
    }.get(id)

# The long description of the check
def detailed_description(id):
    desc = """\
<p><b>Rationale</b></p>
<p>The relevant functions from <ctype.h> are defined to take an int argument
where the expected value is either in the range of an unsigned char or is a
negative value equivalent to EOF. The use of any other values results in
undefined behaviour.</p>
<p><b>Example</b></p>
<p>Note: The int casts in the following example are required to comply with Rule
10.3</p>
<pre><code language="C++">bool_t f ( uint8_t a )
{
return ( isdigit ( ( int32_t ) a ) /* Compliant */
&& isalpha ( ( int32_t ) 'b' ) /* Compliant */
&& islower ( EOF ) /* Compliant */
&& isalpha ( 256 ) ); /* Non-compliant */
}</code></pre>
<p><b>See also</b></p>
<p>Rule 10.3</p>
"""
    return {
        'MISRA23_21.13': desc,
        'CPP_L036': desc,

        'MISRA25_21.13': """<p><b>Rationale</b></p>
<p>The relevant functions from <code>&lt;ctype.h&gt;</code> are defined to take an <em>int</em> argument where the expected value is either in the range of an <em>unsigned char</em> or is a negative value equivalent to <code>EOF</code>. The use of any other values results in <em>undefined behaviour</em>.</p>
<p><b>Example</b></p>
<pre><code language="C">bool_t f ( uint8_t a )
{
  return (      isdigit ( ( int32_t ) a )       /* Compliant        */
             &amp;&amp; isalpha ( ( int32_t ) 'b' )     /* Compliant        */
             &amp;&amp; islower (               EOF )   /* Compliant        */
             &amp;&amp; isalpha (               256 ) );/* Non-compliant    */
}</code></pre>
""",
    }[id]

def test_entity(file):
    return file.kind().check('code file, header file')

def test_language(language):
    return language in ('C', 'C++')


def check(check, file):
    lexer = None

    # ctype entries are often macros rather than functions
    refs = file.filerefs('Call ~Inactive', '~Member Function')
    refs += file.filerefs('Use ~Inactive', 'Functional Macro, Unresolved Macro')

    for ref in refs:
        ent = ref.ent()
        if ent.name() not in CTYPE_FUNCS:
            continue

        if ent.kind().check('Function') and ent.library() != 'standard':
            continue

        if not lexer:
            lexer = file.lexer()
            if not lexer:
                return
        lex = lexer.lexeme(ref.line(), ref.column())
        if not lex or lex.text() != ent.name():
            continue
        lex = lex.next(True, True)
        if not lex or lex.text() != '(':
            continue
        lex = lex.next(True, True)

        # Split the argument into the cast it is written with, if any, and the
        # expression the cast applies to
        cast = []
        arg = []
        paren = 1
        i = 0
        inCast = False
        endOfCast = False
        while lex:
            match lex.text():
                case '(':
                    if i == 0:
                        inCast = True
                    paren += 1
                case ')':
                    paren -= 1
                    if paren == 1:
                        endOfCast = True
                    elif paren == 0:
                        break
            if endOfCast:
                inCast = False
                endOfCast = False
            elif inCast:
                cast.append(lex)
            else:
                arg.append(lex)
            lex = lex.next(True, True)
            i += 1

        # A cast to an unsigned character type makes any operand compliant
        castText = ' '.join(l.text() for l in cast if l.text() != '(')
        if castText in UNSIGNED_CHAR_TYPES:
            continue

        if len(arg) != 1:
            check.violation(ent, file, ref.line(), ref.column(), ERR1)
            continue

        text = arg[0].text()
        if text.startswith("'") or text == 'EOF':
            continue

        argEnt = arg[0].ent()
        if argEnt and argEnt.freetext('UnderlyingType') in UNSIGNED_CHAR_TYPES:
            continue

        num = cParseIntLiteral(text)
        if num != None and num >= 0 and num <= 255:
            continue

        check.violation(ent, file, ref.line(), ref.column(), ERR1)
