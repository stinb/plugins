ERR1 = "Same file shall not be open for read and write access at the same time on different stream"


# The ID for the check
def ids():
    return ('MISRA23_22.3',
               'MISRA25_22.3',
               'MISRA12_22.3'
    )


# The short name of the check
def name(id):
    return {
        'MISRA23_22.3': "Published Standards/MISRA C 2023/22.3 \
The same file shall not be open for read and write access at the same \
time on different streams",
        'MISRA25_22.3': 'Published Standards/MISRA C 2025/22.3 The same file shall not be open for read and write access at the same time on different streams',
        'MISRA12_22.3': 'Published Standards/MISRA C 2012/22.3 The same file shall not be open for read and write access at the same time on different streams',
    }[id]


