# This script is designed to run with Understand - CodeCheck
# Written by Jason Quinn

ERR1 = "Thread synchronization object %1 is accessed before it is initialized"
ERR2 = "Second argument of mtx_init shall be mtx_plain or mtx_timed, either one optionally combined with mtx_recursive"

SYNC_TYPES = {'mtx_t', 'cnd_t'}

INIT_FUNCS = {'mtx_init', 'cnd_init'}

ACCESS_FUNCS = {
    'mtx_lock', 'mtx_trylock', 'mtx_timedlock', 'mtx_unlock', 'mtx_destroy',
    'cnd_wait', 'cnd_timedwait', 'cnd_signal', 'cnd_broadcast', 'cnd_destroy',
}

MTX_CONSTANTS = {'mtx_plain', 'mtx_timed', 'mtx_recursive'}

# mtx_init's type argument, as sets of the constants that may be combined
MTX_TYPES = [
    {'mtx_plain'},
    {'mtx_timed'},
    {'mtx_plain', 'mtx_recursive'},
    {'mtx_timed', 'mtx_recursive'},
]


def ids():
    return ('MISRA23_22.14', 'MISRA25_22.14', 'CPP_L049')


def name(id):
    return {
        'MISRA23_22.14': 'Published Standards/MISRA C 2023/' + """\
22.14 Thread synchronization objects shall be initialized before being accessed""",
        'MISRA25_22.14': 'Published Standards/MISRA C 2025/' + """\
22.14 Thread synchronization objects shall be initialized before being accessed""",
        'CPP_L049': 'All Checks/Language Specific/C and C++/Libraries/' + """\
Thread synchronization objects shall be initialized before being accessed""",
    }[id]


def tags(id):
    return {
        'MISRA23_22.14': [
            'Language: C',
            'Language: C++',
            'Standard: MISRA C 2023',
            'Category: Mandatory',
            'Libraries',
        ],
        'MISRA25_22.14': [
            'Language: C',
            'Standard: MISRA C 2025',
            'Category: Mandatory',
            'Libraries',
        ],
        'CPP_L049': [
            'Language: C',
            'Language: C++',
            'Libraries',
        ],
    }.get(id)


def detailed_description(id):
    return """
<p><b>Amplification</b></p>
<p>Before being accessed, mutex objects shall be initialized by calling
<code>mtx_init()</code>, and condition variables by calling
<code>cnd_init()</code>.</p>
<p>The second parameter of <code>mtx_init()</code> shall be either
<code>mtx_plain</code>, <code>mtx_timed</code>,
<code>( mtx_plain | mtx_recursive )</code>, or
<code>( mtx_timed | mtx_recursive )</code>.</p>

<p><b>Rationale</b></p>
<p>Mutex objects have to be explicitly created by calling function
<code>mtx_init()</code>, and condition variables have to be explicitly created
by calling function <code>cnd_init()</code>.</p>
<p>Initializing all synchronization objects before creating the threads
accessing them is a deterministic way to prevent threads from accessing
synchronization objects with indeterminate state.</p>
<p>Invoking <code>mtx_init()</code> with a different value of its type parameter
than listed above is undefined behaviour.</p>

<p><b>What this check reports</b></p>
<p>An object accessed before it is initialized within the same function, and an
<code>mtx_init()</code> type argument written as constants that are not a
permitted combination.</p>
<p>It does not report the ordering the example below turns on: whether a
synchronization object was initialized before the threads that access it were
created. That is a property of the whole program, so an object of wider scope,
or one passed to another function that may initialize it, is not reported.
The type argument is judged only when written as the standard constants, since
a variable or macro could hold a permitted value.</p>

<p><b>Example</b></p>
<pre><code language="C">mtx_t Ra;
mtx_t Rb;
mtx_t Rc;

int32_t t1( void *ignore )         /* Thread T1 entry */
{
  mtx_init( &amp;Rb, mtx_plain );      /* Non-compliant - T2 may have already accessed Rb */
  /* Subsequently locks/unlocks Ra, Rb, Rc */
}

int32_t t2( void *ignore )
{
  /* locks/unlocks Ra, Rb, Rc */
}

thrd_t id1, id2;

void main( void )
{
  mtx_init( &amp;Ra, mtx_plain );      /* Compliant */
  thrd_create( &amp;id1, t1, NULL );
  thrd_create( &amp;id2, t2, NULL );

  mtx_init( &amp;Rc, mtx_plain );      /* Non-compliant - T1/T2 may have already accessed Rc */

  thrd_join( id1, NULL );
  thrd_join( id2, NULL );
}</code></pre>

<p><b>See also</b></p>
<p>Dir 4.7</p>
"""


def test_entity(file):
    return file.kind().check('code file, header file')


def test_language(language):
    return language == 'C++'


# The synchronization object an argument list refers to, whether its address
# was taken, and the tokens making up the argument that follows it
def call_arguments(lexer, ref):
    lex = lexer.lexeme(ref.line(), ref.column())
    if not lex:
        return None, False, []

    obj = None
    addressed = False
    taken = False
    rest = []
    depth = 0
    seen_comma = False
    while lex:
        text = lex.text()
        if text == '(':
            depth += 1
        elif text == ')':
            depth -= 1
            if not depth:
                break
        elif depth == 1 and text == ',':
            seen_comma = True
        elif depth >= 1:
            if not seen_comma:
                if text == '&':
                    addressed = True
                else:
                    ent = lex.ent()
                    if obj is None and ent and str(ent.type()) in SYNC_TYPES:
                        obj = ent
                        taken = addressed
                    addressed = False
            elif lex.token() in ('Identifier', 'Literal', 'Keyword', 'Macro'):
                rest.append((text, lex.token()))
        lex = lex.next(True, True)

    return obj, taken, rest


# mtx_init's type argument is only judged when every token is a known constant
# or a literal: a variable or macro could hold a permitted value
def invalid_type(rest):
    if not rest:
        return False

    for text, token in rest:
        if token != 'Literal' and text not in MTX_CONSTANTS:
            return False

    return {text for text, _ in rest} not in MTX_TYPES


def check(check, file):
    lexer = None

    for func_ref in file.filerefs('Define', 'Function'):
        func = func_ref.ent()

        contents = str(func.contents())
        if not any(name in contents for name in INIT_FUNCS | ACCESS_FUNCS):
            continue

        if not lexer:
            lexer = file.lexer(lookup_ents=True)
            if not lexer:
                return

        # An object of wider scope may be initialized elsewhere
        local = {ref.ent().id() for ref in func.refs('Define', 'Object')}
        initialized = set()

        escaped = set()

        for call in sorted(func.refs('Call ~Inactive', 'Function'),
                           key=lambda ref: (ref.line(), ref.column())):
            called = call.ent().name()
            known = called in INIT_FUNCS or called in ACCESS_FUNCS

            obj, addressed, rest = call_arguments(lexer, call)
            if obj is None:
                continue

            # Only an address lets another function initialize the object;
            # passing it by value, or using it in a nested call, cannot
            if not known:
                if addressed:
                    escaped.add(obj.id())
                continue

            if called in INIT_FUNCS:
                initialized.add(obj.id())
                if called == 'mtx_init' and invalid_type(rest):
                    check.violation(obj, file, call.line(), call.column(), ERR2)
            elif (obj.id() in local and obj.id() not in escaped
                    and obj.id() not in initialized):
                check.violation(obj, file, call.line(), call.column(), ERR1,
                                obj.name())
