            'Category: Required',
            'Declarations and Definitions',
        ],
    }.get(id)


# The long description of the check
def detailed_description(id):
    desc = """\
<p><b>Amplification</b></p>
<p>The type used to represent characters within a string literal depends on the
encoding prefix:</p>
<ul>
<li>char when there is no prefix — character string literal;</li>
<li>char for a u8 prefix — UTF-8 string literal;</li>
<li>wchar_t for an L prefix — wide string literal;</li>
<li>char16_t for a u prefix — wide string literal;</li>
<li>char32_t for a U prefix — wide string literal.</li>
</ul>
<p>No attempt shall be made to directly modify a character string literal, a
UTF-8 string literal or a wide string literal. The result of the address-of
operator, &, applied to a character string literal or a UTF-8 string literal
shall not be assigned to an object unless that object's type is "pointer to
array of const-qualified char". The result of the address-of operator, &,
applied to a wide string literal shall not be assigned to an object unless that
object's type is "pointer to array of const-qualified wchar_t", "pointer to
array of const-qualified char16_t" or "pointer to array of const-qualified
char32_t", as appropriate for the encoding prefix.</p>
<p><b>Rationale</b></p>
<p>Any attempt to modify a string literal results in undefined behaviour. For
example, some implementations may store string literals in read-only memory in
which case an attempt to modify the string literal will fail and may also result
in an exception or crash. This rule, when applied in conjunction with others,
prevents a string literal from being modified. It is explicitly unspecified in
C99 and later whether string literals that share a common ending are stored in
distinct memory locations. Therefore, even if an attempt to modify a string
literal appears to succeed, it is possible that another string literal might be
inadvertently altered.</p>
<p><b>Exception</b></p>
<p>This rule does not apply to a string literal passed as an argument to the
variable argument list of a variadic function.</p>
<p><b>Example</b></p>
<p>The following example shows an attempt to modify a string literal directly:
</p>
<pre><code language="C++">"0123456789"[0] = '*'; /* Non-compliant */</code></pre>
<p>These examples show how to prevent modification of string literals
indirectly:</p>
<pre><code language="C++">/* Non-compliant - s is not const-qualified */
char *s = "string";
/* Compliant - p is const-qualified; additional qualifiers are permitted */
const volatile char *p = "string";
extern void f1 ( char *s1 );
extern void f2 ( const char *s2 );
void g ( void )
{
  f1 ( "string" ); /* Non-compliant - parameter s1 is not
  * const-qualified */
  f2 ( "string" ); /* Compliant */
}
char *name1 ( void )
{
  return ( "MISRA" ); /* Non-compliant - return type is not
                       * const-qualified */
}
const char *name2 ( void )
{
  return ( "MISRA" ); /* Compliant */
}</code></pre>
<p>This example shows the permitted exemption for variadic functions:</p>
<pre><code language="C++">extern void f3( uint16_t x, ... ); /* Note: non-compliant with Rule 17.1 */
extern void f4( char *text, ... ); /* Note: non-compliant with Rule 17.1 */
void variadic( void )
{
f3( 42u, "MISRA" ); /* Compliant by exception */
f4( "MISRA", 42u ); /* Non-compliant - exception only applies to
variable argument lists */
}</code></pre>
<p><b>See also</b></p>
<p>Rule 11.4, Rule 11.8, Rule 17.1</p>
"""
    return {
        'MISRA23_7.4': desc,
        'MISRA12_7.4': desc,
        'CPP_DD027': desc,
        'MISRA25_7.4': """<p><b>Amplification</b></p>
<p>The type used to represent characters within a string literal depends on the encoding prefix:</p>
<ul>
<li><i>char</i> when there is no prefix — <i>character string literal</i>;</li>
<li><i>char</i> for a <code>u8</code> prefix — <i>UTF-8 string literal</i>;</li>
<li><i>wchar_t</i> for an <code>L</code> prefix — <i>wide string literal</i>;</li>
<li><i>char16_t</i> for a <code>u</code> prefix — <i>wide string literal</i>;</li>
<li><i>char32_t</i> for a <code>U</code> prefix — <i>wide string literal</i>.</li>
</ul>
<p>No attempt shall be made to directly modify a character string literal, a UTF-8 string literal or a wide string literal.</p>
<p>The result of the address-of operator, <code>&amp;</code>, applied to a character string literal or a UTF-8 string literal shall not be <i>assigned</i> to an object unless that object's type is "pointer to array of <i>const</i>-qualified <i>char</i>".</p>
<p>The result of the address-of operator, <code>&amp;</code>, applied to a wide string literal shall not be <i>assigned</i> to an object unless that object's type is "pointer to array of <i>const</i>-qualified <i>wchar_t</i>", "pointer to array of <i>const</i>-qualified <i>char16_t</i>" or "pointer to array of <i>const</i>-qualified <i>char32_t</i>", as appropriate for the encoding prefix.</p>
<p><b>Rationale</b></p>
<p>Any attempt to modify a string literal results in undefined behaviour. For example, some implementations may store string literals in read-only memory in which case an attempt to modify the string literal will fail and may also result in an exception or crash.</p>
<p>This rule, when applied in conjunction with others, prevents a string literal from being modified.</p>
<p>It is explicitly unspecified in C99 and later whether string literals that share a common ending are stored in distinct memory locations. Therefore, even if an attempt to modify a string literal appears to succeed, it is possible that another string literal might be inadvertently altered.</p>
<p><b>Exception</b></p>
<p>This rule does not apply to a string literal passed as an argument to the variable argument list of a variadic function.</p>
<p><b>Example</b></p>
<pre><code language="C">"0123456789"[0] = '*';    /* Non-compliant                              */

/* Non-compliant - s is not const-qualified */
char *s = "string";

/* Compliant - p is const-qualified; additional qualifiers are permitted */
const volatile char *p = "string";

extern void f1 ( char *s1 );

extern void f2 ( const char *s2 );

void g ( void )
{
  f1 ( "string" );      /* Non-compliant - parameter s1 is not
                          * const-qualified                              */
  f2 ( "string" );      /* Compliant                                    */
}

char *name1 ( void )
{
  return ( "MISRA" );   /* Non-compliant - return type is not
                          * const-qualified                              */
}

const char *name2 ( void )
{
  return ( "MISRA" );   /* Compliant                                    */
}
</code></pre>
<p>This example shows the permitted exemption for variadic functions:</p>
<pre><code language="C">extern void f3( uint16_t x, ... );   /* Note: non-compliant with Rule 17.1 */
extern void f4( char *text, ... );   /* Note: non-compliant with Rule 17.1 */

void variadic( void )
{
  f3( 42u, "MISRA" );   /* Compliant by exception                          */
  f4( "MISRA", 42u );   /* Non-compliant - exception only applies to
                          * variable argument lists                         */
}
</code></pre>
""",
    }[id]

# Tests the type of file
def test_entity(file):
    return file.kind().check('file')

def test_global():
    return False

def test_language(language):
    return language == 'C++'

def check(check, file):
    lexer = file.lexer()
    if not lexer:
        return

    # Assignments and initializations of objects
    for ref in file.filerefs('Set', 'Object, Parameter'):
        if not violatingTarget(ref.ent().type(), ref.ent().freetext('UnderlyingType')):
            continue
        lexeme = lexer.lexeme(ref.line(), ref.column())
        if not lexeme:
            continue
        # Members set by a positional struct initializer are positioned at the value
        if ref.kind().check('Init Implicit'):
            tokens, _ = collect(lexeme, (',',))
            if isStringLiteral(tokens):
                check.violation(ref.scope(), file, ref.line(), ref.column(), ERR1)
            continue
        # Sets inside a macro expansion are positioned at the macro name
        if lexeme.text() != ref.ent().name():
            continue
        lexeme = lexeme.next(True, True)
        if ref.kind().check('Init'):
            lexeme = skipDimensions(lexeme)
        if not (lexeme and lexeme.text() == '='):
            continue
        tokens, _ = collect(lexeme.next(True, True), (';', ','))
        if tokens and tokens[0].text() == '{':
            # Every element of an array shares the pointee type tested above
            for literal in bracedLiterals(tokens):
                check.violation(ref.scope(), file, literal.line_begin(), literal.column_begin(), ERR1)
        elif isStringLiteral(tokens):
            check.violation(ref.scope(), file, ref.line(), ref.column(), ERR1)

    # Returns from functions
    for ref in file.filerefs('Define', 'Function', True):
        func = ref.ent()
        if not violatingTarget(func.type(), func.freetext('UnderlyingType')):
            continue
        begin = func.ref('Begin Body') or func.ref('Begin')
        end = func.ref('End')
        if not (begin and end and begin.file() == file and end.file() == file):
            continue
        lexeme = lexer.lexeme(begin.line(), begin.column())
        close = lexer.lexeme(end.line(), end.column())
        while lexeme and close and checkLexBounds(lexeme, close):
            if lexeme.text() == 'return':
                tokens, lexeme = collect(lexeme.next(True, True), (';',))
                if isStringLiteral(tokens):
                    check.violation(func, file, tokens[0].line_begin(), tokens[0].column_begin(), ERR1)
            if lexeme:
                lexeme = lexeme.next(True, True)

    # Arguments of function calls
    for ref in file.filerefs('Call ~Implicit', 'Function'):
        lexeme = lexer.lexeme(ref.line(), ref.column())
        # Calls inside a macro expansion are positioned at the macro name
        if not (lexeme and lexeme.text() == ref.ent().name()):
            continue
        lexeme = lexeme.next(True, True)
        if not (lexeme and lexeme.text() == '('):
            continue
        params = parameterTypes(ref.ent())
        index = 0
        stop = lexeme
        while stop and stop.text() in ('(', ','):
            tokens, stop = collect(stop.next(True, True), (',', ')'))
            # Arguments past the named parameters belong to a variable argument list
            if index >= len(params) or any(expandsToList(token) for token in tokens):
                break
            if isStringLiteral(tokens) and violatingTarget(*params[index]):
                check.violation(ref.scope(), file, ref.line(), ref.column(), ERR1)
            index += 1


# (declared type, underlying type) of each named parameter, in order
def parameterTypes(func):
    refs = func.refs('Define', 'Parameter', True) or func.refs('Declare', 'Parameter', True)
    if refs:
        # Already in declaration order; '...' may be positioned at a macro instead
        params = []
        for ref in refs:
            if ref.ent().name() == '...':
                break
            params.append((ref.ent().type(), ref.ent().freetext('UnderlyingType')))
        return params

    # Library functions have no parameter entities, only the declared text
    params = []
    text = func.parameters() or ''
    depth = 0
    current = ''
    for char in text:
        if char in '([':
            depth += 1
        elif char in ')]':
            depth -= 1
        if char == ',' and depth == 0:
            params.append(current.strip())
            current = ''
        else:
            current += char
    if current.strip() and current.strip() not in ('...', 'void'):
        params.append(current.strip())
    return [(param, None) for param in params]


# True if a string literal stored in this type is not "pointer to const-qualified char"
def violatingTarget(declared, underlying):
    declared = str(declared or '')
    underlying = str(underlying or declared)
    # Arrays copy the literal, and non-pointer types cannot hold it
    if '*' not in underlying:
        return False
    return not (pointsToConstChar(declared) or pointsToConstChar(underlying))


def pointsToConstChar(type):
    if '*' not in type:
        return False
    pointee = type[:type.rindex('*')]
    return bool(re.search(r'\bconst\b', pointee) and re.search(r'\b(char|wchar_t|char8_t|char16_t|char32_t)\b', pointee))


# Lexemes up to the first stop at depth 0, and the lexeme that ended the walk
def collect(lexeme, stops):
    tokens = []
    depth = 0
    while lexeme:
        text = lexeme.text()
        if depth == 0 and (text in stops or text in (')', ']', '}')):
            break
        if text in ('(', '[', '{'):
            depth += 1
        elif text in (')', ']', '}'):
            depth -= 1
        tokens.append(lexeme)
        lexeme = lexeme.next(True, True)
    return tokens, lexeme


# The lexeme after any array dimensions in a declarator
def skipDimensions(lexeme):
    while lexeme and lexeme.text() == '[':
        _, lexeme = collect(lexeme.next(True, True), ())
        if lexeme:
            lexeme = lexeme.next(True, True)
    return lexeme


# First lexeme of each string literal element in a brace-enclosed initializer list
def bracedLiterals(tokens):
    if not (tokens and tokens[0].text() == '{' and tokens[-1].text() == '}'):
        return []
    literals = []
    element = []
    depth = 0
    for token in tokens[1:-1] + [None]:
        text = token.text() if token else ','
        if depth == 0 and text == ',':
            # Drop a designator such as [2] =
            if element and element[0].text() == '[':
                close = next((i for i, t in enumerate(element) if t.text() == ']'), None)
                if close is not None and close + 1 < len(element) and element[close + 1].text() == '=':
                    element = element[close + 2:]
            if element and element[0].text() == '{':
                literals += bracedLiterals(element)
            elif isStringLiteral(element):
                literals.append(element[0])
            element = []
            continue
        if text in ('(', '[', '{'):
            depth += 1
        elif text in (')', ']', '}'):
            depth -= 1
        element.append(token)
    return literals


# True if the expression is a string literal, optionally parenthesized or cast
def isStringLiteral(tokens):
    if not tokens:
        return False
    if isConcatenation(tokens):
        return True
    if tokens[0].text() != '(':
        return False
    depth = 0
    for i, token in enumerate(tokens):
        if token.text() == '(':
            depth += 1
        elif token.text() == ')':
            depth -= 1
            if depth == 0:
                if i == len(tokens) - 1:
                    return isStringLiteral(tokens[1:-1])
                return isStringLiteral(tokens[i + 1:])
    return False


# True if the token is a macro that expands to several comma-separated values
def expandsToList(token):
    ent = token.ent()
    if not (ent and ent.kind().check('Macro')):
        return False
    depth = 0
    for char in str(ent.value() or ''):
        if char in '([{':
            depth += 1
        elif char in ')]}':
            depth -= 1
        elif char == ',' and depth == 0:
            return True
    return False


# True if the tokens are adjacent string literals, or macros that expand to one
def isConcatenation(tokens):
    i = 0
    while i < len(tokens):
        token = tokens[i]
        if token.token() == 'String' and re.match(r'(u8|u|U|L)?"', token.text()):
            i += 1
            continue
        ent = token.ent()
        if not (ent and ent.kind().check('Macro') and str(ent.value() or '').lstrip().startswith('"')):
            return False
        i += 1
        # Skip the macro's argument list
        if i < len(tokens) and tokens[i].text() == '(':
            depth = 0
            while i < len(tokens):
                if tokens[i].text() == '(':
                    depth += 1
                elif tokens[i].text() == ')':
                    depth -= 1
                    if depth == 0:
                        break
                i += 1
            i += 1
    return True


# Return False if 'lexeme' has passed position of 'close'
def checkLexBounds(lexeme, close):
    if lexeme.line_begin() > close.line_begin():
        return False
    if lexeme.line_begin() == close.line_begin() and lexeme.column_begin() >= close.column_begin():
        return False
    return True
