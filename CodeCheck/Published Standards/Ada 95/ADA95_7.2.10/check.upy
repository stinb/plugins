ERR1 = "Do not use a representation clause to specify 'Storage_Size"


def ids():
    return ("ADA95_7.2.10",)


def name(id):
    return {
        "ADA95_7.2.10": "Published Standards/Ada 95/7.2.10 Representation Clause",
    }[id]


def tags(id):
    return {
        "ADA95_7.2.10": [
            "Language: Ada",
            "Standard: Ada 95",
            "Portability",
        ],
    }.get(id, [])


def detailed_description(id):
    return {
        "ADA95_7.2.10": """
<p><b>Guideline</b></p>
<p>Do not use a representation clause to specify number of storage
units.</p>

<p><b>Rationale</b></p>
<p>The meaning of the 'Storage_Size attribute is ambiguous; specifying a
particular value will not improve portability. It may or may not
include space allocated for parameters, data, etc. Save the use of this
feature for designs that must depend on a particular vendor's
implementation.</p>

<p><b>Notes</b></p>
<p>During a porting activity, it can be assumed that any occurrence of
storage specification indicates an implementation dependency that must
be redesigned.</p>

<p><b>Developer's Note</b></p>
<p>Automated directly: an attribute definition clause of the form
<code>for X'Storage_Size use N;</code> is a specific, fixed syntax
(<code>Representation Ref</code> in Understand's model, confirmed by the lexer
to be for the <code>Storage_Size</code> attribute specifically rather than
<code>'Size</code>, <code>'Alignment</code>, or another representation attribute), so
every occurrence is flagged regardless of target (a task, a task type,
or an access type) or the value supplied. The companion
<code>pragma Storage_Size (N);</code> form is a different language construct
(a pragma, not a representation clause) and is not what this guideline's
wording addresses, so it is not flagged.</p>
""",
    }[id]


def test_entity(file):
    return file.kind().check("Ada File")


def test_language(language):
    return language == "Ada"


def _is_storage_size_clause(lexer, ref):
    lex = lexer.lexeme(ref.line(), ref.column())

    if not lex:
        return False

    lex = lex.next(True, True)

    if not lex or lex.text() != "'":
        return False

    lex = lex.next(True, True)

    return bool(lex) and lex.text().lower() == "storage_size"


def check(check, file):
    lexer = file.lexer(lookup_ents=False)

    for ref in file.filerefs("Representation Ref"):
        if _is_storage_size_clause(lexer, ref):
            check.violation(ref.ent(), file, ref.line(),
                            ref.column(), ERR1)
