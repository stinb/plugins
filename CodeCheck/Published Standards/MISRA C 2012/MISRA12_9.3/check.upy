        ],
        'MISRA25_9.3': [
            'Language: C',
            'Standard: MISRA C 2025',
            'Category: Required',
            'Declarations and Definitions',
        ],
    }.get(id)

def detailed_description():
    return """\
<p><b>Amplification</b></p>
<p>If any element of an array object or subobject is explicitly initialized,
then the entire object or subobject shall be explicitly initialized.</p>
<p><b>Rationale</b></p>
<p>Providing an explicit initialization for each element of an array makes it
clear that every element has been considered.</p>
<p><b>Exception</b></p>
<ol type="1">
<li>An initializer of the form { 0 } may be used to explicitly initialize all
elements of an array object or subobject.</li>
<li>An array whose initializer consists only of designated initializers may be
used, for example to perform a sparse initialization.</li>
<li>An array initialized using a string literal does not need an initializer for
every element.</li></ol>
<p><b>Example</b></p>
<pre><code language="C++">/* Compliant */
int32_t x[ 3 ] = { 0, 1, 2 };
/* Non-compliant - y[ 2 ] is implicitly initialized */
int32_t y[ 3 ] = { 0, 1 };
/* Non-compliant - t[ 0 ] and t[ 3 ] are implicitly initialized */
float32_t t[ 4 ] = { [ 1 ] = 1.0f, 2.0f };
/* Compliant - designated initializers for sparse matrix */
float32_t z[ 50 ] = { [ 1 ] = 1.0f, [ 25 ] = 2.0f };</code></pre>
<p>In the following compliant example, each element of the array arr is
initialized:</p>
<pre><code language="C++">float32_t arr[ 3 ][ 2 ] =
{
  { 0.0f, 0.0f },
  { PI / 4.0f, -PI / 4.0f },
  { 0 } /* initializes all elements of array subobject arr[ 2 ] */
};</pre></code>
<p>In the following example, array elements 6 to 9 are implicitly initialized to
'\\0':</p>
<pre><code language="C++">char h[ 10 ] = "Hello"; /* Compliant by Exception 3 */
</pre></code>"""

def test_entity(file):
    return file.kind().check('code file, header file')

def test_language(language):
    return language == 'C++'


def check(check, file):
    lexer = None
    for ref in file.filerefs('Set ~Deref', 'Object ~Member'):
        dims = re.findall(r'\[(\d*)\]', str(ref.ent().type()))
        if not dims or '' in dims:
            continue
        dims = [int(dim) for dim in dims]

        if not lexer:
            lexer = file.lexer()
            if not lexer:
                return
        lexeme = lexer.lexeme(ref.line(), ref.column())
        # Sets inside a macro expansion are positioned at the macro name
        if not (lexeme and lexeme.text() == ref.ent().name()):
            continue
        lexeme = lexeme.next(True, True)

        # An outer dimension sized by its initializer cannot be partially initialized
        unsized = False
        if lexeme and lexeme.text() == '[':
            after = lexeme.next(True, True)
            unsized = bool(after and after.text() == ']')
        while lexeme and lexeme.text() == '[':
            while lexeme and lexeme.text() != ']':
                lexeme = lexeme.next(True, True)
            if lexeme:
                lexeme = lexeme.next(True, True)
        if not (lexeme and lexeme.text() == '='):
            continue
        lexeme = lexeme.next(True, True)
        if not (lexeme and lexeme.text() == '{'):
            continue

        tokens = bracedTokens(lexeme)
        # Elements supplied by a preprocessor directive cannot be counted
        if not tokens or any(token.token() == 'Preprocessor' for token in tokens):
            continue
        if not fullyInitialized(tokens[1:-1], dims, unsized):
            check.violation(ref.ent(), file, ref.line(), ref.column(), ERR1)


# Lexemes from an opening brace to its matching closing brace
def bracedTokens(lexeme):
    tokens = []
    depth = 0
    while lexeme:
        tokens.append(lexeme)
        if lexeme.text() == '{':
            depth += 1
        elif lexeme.text() == '}':
            depth -= 1
            if depth == 0:
                return tokens
        lexeme = lexeme.next(True, True)
    return None


# Top-level comma-separated elements of an initializer list
def elementsOf(tokens):
    elements = [[]]
    depth = 0
    for token in tokens:
        text = token.text()
        if text == ',' and depth == 0:
            elements.append([])
            continue
        if text in ('(', '[', '{'):
            depth += 1
        elif text in (')', ']', '}'):
            depth -= 1
        elements[-1].append(token)
    return [element for element in elements if element]


def isBraced(element):
    return element[0].text() == '{' and element[-1].text() == '}'


def isStringLiteral(element):
    return all(token.token() == 'String' and re.match(r'(u8|u|U|L)?"', token.text()) for token in element)


def isZero(text):
    return bool(re.fullmatch(r"0+[uUlL]*|0[xX]0+[uUlL]*|(0+\.0*|\.0+)([eE][+-]?\d+)?[fFlL]?|[LuU]?'\\0'", text))


def product(dims):
    total = 1
    for dim in dims:
        total *= dim
    return total


# True if the initializer list covers every element of an array with these dimensions
def fullyInitialized(tokens, dims, unsized=False):
    elements = elementsOf(tokens)
    if not elements:
        return True
    # Exception: { 0 }, also accepting other zero-valued literals such as 0U, 0.0f and '\0'
    if len(elements) == 1 and len(elements[0]) == 1 and isZero(elements[0][0].text()):
        return True
    # Exception: only designated initializers
    if all(element[0].text() in ('[', '.') for element in elements):
        return True

    if len(dims) == 1:
        # Exception: a string literal
        if len(elements) == 1 and isStringLiteral(elements[0]):
            return True
        return unsized or len(elements) >= dims[0]

    inner = dims[1:]
    if all(isBraced(element) or (len(inner) == 1 and isStringLiteral(element)) for element in elements):
        if not unsized and len(elements) < dims[0]:
            return False
        return all(isStringLiteral(element) or fullyInitialized(element[1:-1], inner) for element in elements)

    # Braces elided: the elements fill the array in order
    if not any(isBraced(element) for element in elements):
        if unsized:
            return len(elements) % product(inner) == 0
        return len(elements) >= product(dims)

    # Partly elided braces are not analyzed
    return True
