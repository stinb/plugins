import Modules

ERR1 = 'Composite expression of %1 type assigned to an object of %2 type, which is wider'


# The ID for the check
def ids():
    return ('MISRA12_10.6', 'MISRA23_10.6', 'CPP_E077',
               'MISRA25_10.6'
    )

# The short name of the check
def name(id):
    return {
        'MISRA12_10.6': 'Published Standards/MISRA C 2012/' + """\
10.6 The value of a composite expression shall not be assigned to an object \
with wider essential type""",
        'MISRA23_10.6': 'Published Standards/MISRA C 2023/' + """\
10.6 The value of a composite expression shall not be assigned to an object \
with wider essential type""",
        'CPP_E077': 'All Checks/Language Specific/C and C++/Expressions/' + """\
The value of a composite expression shall not be assigned to an object with \
wider essential type""",
        'MISRA25_10.6': 'Published Standards/MISRA C 2025/10.6 The value of a composite expression shall not be assigned to an object with wider essential type',
    }[id]




def tags(id):
    return {
        'MISRA12_10.6': [
            'Language: C',
            'Language: C++',
            'Standard: MISRA C 2012',
            'Category: Required',
            'Expressions',
        ],
        'MISRA23_10.6': [
            'Language: C',
            'Language: C++',
            'Standard: MISRA C 2023',
            'Category: Required',
            'Expressions',
        ],
        'CPP_E077': [
            'Language: C',
            'Language: C++',
            'Expressions',
        ],
        'MISRA25_10.6': [
            'Language: C',
            'Standard: MISRA C 2025',
            'Category: Required',
            'Expressions',
        ],
    }.get(id)


# The long description of the check
def detailed_description(id):
    desc = """\
<p><b>Amplification</b></p>
<p>This rule covers the assigning operations described in Rule 10.3.</p>
<p><b>Rationale</b></p>
<p>The rationale is described in the introduction on composite operators and expressions (see Section8.10.3).</p>
<p><b>Example</b></p>
<p>The following are compliant</p>
<pre><code language="C++">u16c = u16a + u16b; /* Same essential type */
u32a = ( uint32_t ) u16a + u16b; /* Cast causes addition in uint32_t */</pre></code>
<p>The following are non-compliant</p>
<pre><code language="C++">u32a = u16a + u16b; /* Implicit conversion on assignment */
use_uint32 ( u16a + u16b ); /* Implicit conversion of fn argument */</pre></code>
"""
    return {
        'MISRA12_10.6': desc,
        'MISRA23_10.6': desc,
        'CPP_E077': desc,

        'MISRA25_10.6': """<p><b>Amplification</b></p>
<p>This rule covers the assigning operations described in Rule 10.3.</p>
<p><b>Rationale</b></p>
<p>The rationale is described in the introduction on <i>composite operators and expressions</i> (see Section 5.10.3).</p>
<p><b>Example</b></p>
<pre><code language="C">/* Compliant: */
u16c = u16a + u16b;               /* Same essential type                    */
u32a = ( uint32_t ) u16a + u16b;  /* Cast causes addition in uint32_t       */

/* Non-compliant: */
u32a = u16a + u16b;               /* Implicit conversion on assignment       */
use_uint32 ( u16a + u16b );       /* Implicit conversion of fn argument      */
</code></pre>
""",
    }[id]

# Tests the type of file
def test_entity(file):
    return file.kind().check('file')

def test_global():
    return False

def test_language(language):
    return language == 'C++'

def check(check, file):
    for lexeme, target, value, ent in Modules.cAssignments(file):
        # A compound assignment operates on the object itself, so its result is
        # never of an essential type wider than the object
        if lexeme.text() != '=':
            continue
        left = Modules.cEssentialTypeOfExpression(target)
        if isWider(left, value):
            check.violation(ent, file, lexeme.line_begin(), lexeme.column_begin(),
                            ERR1, describe(value), Modules.cDescribeEssentialType(left))

    # Passing an argument assigns it to the parameter
    for callRef in file.filerefs('Call', 'Function'):
        parameters = callRef.ent().ents('Define', 'Parameter')
        for i, parameter in enumerate(parameters):
            argument = Modules.nthParamOfCall(callRef, i)
            if not argument:
                continue
            left = Modules.cEssentialType(parameter.type(), parameter)
            if isWider(left, argument):
                check.violation(callRef.ent(), file, callRef.line(), callRef.column(),
                                ERR1, describe(argument), Modules.cDescribeEssentialType(left))


# The essential type of a composite expression, as a report words it
def describe(value):
    return Modules.cDescribeEssentialType(Modules.cEssentialTypeOfExpression(value))


# Whether a composite expression is assigned to a wider essential type. A
# different essential type category is Rule 10.3, not this rule.
def isWider(left, value):
    if not left or not Modules.cIsCompositeExpression(value):
        return False

    right = Modules.cEssentialTypeOfExpression(value)
    if not right or left[0] != right[0]:
        return False
    if Modules.C_ESSENTIAL_POINTER in (left[0], right[0]):
        return False
    if left[1] is None or right[1] is None:
        return False

    return left[1] > right[1]
