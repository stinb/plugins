import Modules

ERR1 = 'The operands of %1 are %2 and %3, different essential type categories'


# The ID for the check
def ids():
    return ('MISRA12_10.4', 'MISRA23_10.4', 'CPP_E075',
               'MISRA25_10.4'
    )

# The short name of the check
def name(id):
    return {
        'MISRA12_10.4': 'Published Standards/MISRA C 2012/' + """\
10.4 Both operands of an operator in which the usual arithmetic conversions are\
 performed shall have the same essential type category""",
        'MISRA23_10.4': 'Published Standards/MISRA C 2023/' + """\
10.4 Both operands of an operator in which the usual arithmetic conversions are\
 performed shall have the same essential type category""",
        'CPP_E075': 'All Checks/Language Specific/C and C++/Expressions/' + """\
Both operands of an operator in which the usual arithmetic conversions are \
performed shall have the same essential type category""",
        'MISRA25_10.4': 'Published Standards/MISRA C 2025/10.4 Both operands of an operator in which the usual arithmetic conversions are performed shall have the same essential type category',
    }[id]




def tags(id):
    return {
        'MISRA12_10.4': [
            'Language: C',
            'Language: C++',
            'Standard: MISRA C 2012',
            'Category: Required',
            'Expressions',
        ],
        'MISRA23_10.4': [
            'Language: C',
            'Language: C++',
            'Standard: MISRA C 2023',
            'Category: Required',
            'Expressions',
        ],
        'CPP_E075': [
            'Language: C',
            'Language: C++',
            'Expressions',
        ],
        'MISRA25_10.4': [
            'Language: C',
            'Standard: MISRA C 2025',
            'Category: Required',
            'Expressions',
        ],
    }.get(id)


# The long description of the check
def detailed_description(id):
    desc = """\
<p><b>Amplification</b></p>
<p>This rule applies to operators that are described in usual arithmetic
conversions section in the C Standard. This includes all the binary operators,
excluding the shift, logical &&, logical || and comma operators. In addition,
the second and third operands of the ternary operator are covered by this rule.
</p>
<p>Note: the increment and decrement operators are not covered by this rule.</p>
<p><b>Rationale</b></p>
<p>The C language allows the programmer considerable freedom and will permit
conversions between different arithmetic types to be performed automatically.
However, the use of these implicit conversions can lead to unintended results,
with the potential for loss of value, sign or precision. Further details of
concerns with the C type system can be found in Appendix C. The use of stronger
typing, as enforced by the MISRA essential type model, allows implicit
conversions to be restricted to those that should then produce the answer
expected by the developer.</p>
<p>The use of stronger typing, as enforced by the MISRA essential type model,
allows implicit conversions to be restricted to those that should then produce
the answer expected by the developer.</p>
<p><b>Exception</b></p>
<p>The following are permitted to allow a common form of character manipulation
to be used:</p>
<ol>
<li>The binary + and += operators may have one operand with essentially
character type and the other operand with an essentially signed or essentially
unsigned type;</li>
<li>The binary - and -= operators may have a left-hand operand with essentially
character type and a right-hand operand with an essentially signed or
essentially unsigned type.</li>
</ol>
<p><b>Example</b></p>
<pre><code language="C++">enum enuma { A1, A2, A3 } ena;
enum enumb { B1, B2, B3 } enb;</code></pre>
<p>The following are compliant as they have the same essential type category:
</p>
<pre><code language="C++">ena > A1
u8a + u16b</pre></code>
<p>The following is compliant by exception 1:</p>
<pre><code language="C++">cha += u8a</pre></code>
<p>The following is compliant by exception 1, but violates Rule 10.3:</p>
<pre><code language="C++">u8a += cha /* unsigned and char */</pre></code>
<pre><code language="C++"></pre></code>
<p>The following is compliant by exception 3.</p>
<pre><code language="C++">cf32a += f32a; /* complex floating and real floating */
</pre></code>
<p>The following is non-compliant with this rule and also violates Rule 10.3:
</p>
<pre><code language="C++">s8a += u8a /* signed and unsigned */</pre></code>
<p>The following are non-compliant:</p>
<pre><code language="C++">u8b + 2 /* unsigned and signed */
enb > A1 /* enum<enumb> and enum<enuma> */
ena == enb /* enum<enuma> and enum<enumb> */</pre></code>
<p><b>Developer's Notes</b></p>
<p>Operators written inside a macro definition or a preprocessor directive are
not checked, and neither are operands that are pointers. Two enumerated
operands are only reported when both of their enumerations are known.</p>
"""
    return {
        'MISRA12_10.4': desc,
        'MISRA23_10.4': desc,
        'CPP_E075': desc,

        'MISRA25_10.4': """<p><b>Amplification</b></p>
<p>This rule applies to operators that are described in <i>usual arithmetic conversions</i> section in the C Standard. This includes all the binary operators, excluding the shift, logical <code>&amp;&amp;</code>, logical <code>||</code> and comma operators. In addition, the second and third operands of the ternary operator are covered by this rule.</p>
<p><i>Note:</i> the increment and decrement operators are not covered by this rule.</p>
<p><b>Rationale</b></p>
<p>The C language allows the programmer considerable freedom and will permit conversions between different arithmetic types to be performed automatically. However, the use of these implicit conversions can lead to unintended results, with the potential for loss of value, sign or precision. Further details of concerns with the C type system can be found in Appendix C.</p>
<p>The use of stronger typing, as enforced by the MISRA <i>essential type model</i>, allows implicit conversions to be restricted to those that should then produce the answer expected by the developer.</p>
<p><b>Exception</b></p>
<p>The following are permitted to allow a common form of character manipulation to be used:</p>
<ol>
<li>The binary + and += operators may have one operand with <i>essentially character</i> type and the other operand with an <i>essentially signed</i> or <i>essentially unsigned</i> type;</li>
<li>The binary - and -= operators may have a left-hand operand with <i>essentially character</i> type and a right-hand operand with an <i>essentially signed</i> or <i>essentially unsigned</i> type.</li>
<li>The operators covered by this rule may have one operand with <i>essentially real floating</i> type and the other operand with <i>essentially complex floating</i> type. In the case of the conditional operator, this exception applies to the second and third operands.</li>
</ol>
<p><b>Example</b></p>
<pre><code language="C">enum enuma { A1, A2, A3 } ena;
enum enumb { B1, B2, B3 } enb;

/* Compliant - same essential type category: */
ena &gt; A1
u8a + u16b

/* Compliant by exception 1: */
cha += u8a

/* Compliant by exception 3: */
cf32a += f32a;    /* complex floating and real floating */

/* Non-compliant with this rule and also violates Rule 10.3: */
s8a += u8a        /* signed and unsigned                */

/* Non-compliant: */
u8b + 2           /* unsigned and signed                */
enb &gt; A1          /* enum&lt;enumb&gt; and enum&lt;enuma&gt;        */
ena == enb        /* enum&lt;enuma&gt; and enum&lt;enumb&gt;        */
</code></pre>
""",
    }[id]

# Tests the type of file
def test_entity(file):
    return file.kind().check('file')

def test_global():
    return False

def test_language(language):
    return language == 'C++'

# Binary operators that perform the usual arithmetic conversions, and the
# compound assignments that do
OPERATORS = {'*', '/', '%', '+', '-', '<', '<=', '>', '>=', '==', '!=', '&', '^', '|'}
COMPOUND_OPERATORS = {'*=', '/=', '%=', '+=', '-=', '&=', '^=', '|='}

# Keywords that can end an operand, so the operator after them is binary
OPERAND_KEYWORDS = {'true', 'false', 'this', 'nullptr'}

NUMERIC = (Modules.C_ESSENTIAL_SIGNED, Modules.C_ESSENTIAL_UNSIGNED)


def check(check, file):
    lexer = file.lexer()
    if not lexer:
        return

    directive = False
    previous = None
    for lexeme in lexer.lexemes():
        token = lexeme.token()
        if token == 'Newline':
            # A directive continues past a line ending in a backslash
            directive = directive and bool(previous) and previous.text().endswith('\\')
            continue
        if token == 'Preprocessor' and lexeme.text() == '#':
            directive = True
        if token not in ('Whitespace', 'Comment'):
            previous = lexeme
        if directive or token != 'Operator' or lexeme.inactive():
            continue

        text = lexeme.text()
        if text == '?':
            operands = conditionalOperands(lexeme)
        elif text in COMPOUND_OPERATORS:
            operands = (Modules.cAssignmentTarget(lexeme), Modules.cAssignedExpression(lexeme))
        elif text in OPERATORS and isBinary(lexeme):
            operands = (leftOperand(lexeme), rightOperand(lexeme))
        else:
            continue
        if not operands[0] or not operands[1]:
            continue

        left = Modules.cEssentialTypeOfExpression(operands[0])
        right = Modules.cEssentialTypeOfExpression(operands[1])
        if not left or not right or Modules.C_ESSENTIAL_POINTER in (left[0], right[0]):
            continue
        if sameCategory(left, right, operands) or isException(text, left, right):
            continue

        check.violation(entityOf(operands[0]), file, lexeme.line_begin(), lexeme.column_begin(), ERR1,
                        text, Modules.cDescribeEssentialType(left),
                        Modules.cDescribeEssentialType(right))


def sameCategory(left, right, operands):
    if left[0] != right[0]:
        return False
    if left[0] != Modules.C_ESSENTIAL_ENUM:
        return True
    # Each enumeration is its own essential type
    leftEnum, rightEnum = (Modules.cEnumType(entityOf(operand)) for operand in operands)
    return not (leftEnum and rightEnum) or leftEnum == rightEnum


def entityOf(lexemes):
    lexeme = Modules.cTermLexeme(lexemes)
    return lexeme.ent() if lexeme else None


# Exception: character manipulation with + and -
def isException(operator, left, right):
    if operator in ('+', '+='):
        return ((left[0] == Modules.C_ESSENTIAL_CHARACTER and right[0] in NUMERIC)
                or (right[0] == Modules.C_ESSENTIAL_CHARACTER and left[0] in NUMERIC))
    if operator in ('-', '-='):
        return left[0] == Modules.C_ESSENTIAL_CHARACTER and right[0] in NUMERIC
    return False


# True if an operator has a left operand, which rules out a prefix operator, a
# pointer or reference declarator, and the angle brackets of a template
def isBinary(lexeme):
    before = lexeme.previous(True, True)
    if not before:
        return False
    text = before.text()
    if text == ')':
        return not closesCast(before)
    if text == ']':
        return True
    if before.token() == 'Keyword':
        return text in OPERAND_KEYWORDS
    if before.token() in ('Literal', 'String'):
        return True
    if before.token() != 'Identifier':
        return False
    ent = before.ent()
    if ent and ent.kind().check('Typedef, Type, Template'):
        return False
    return True


# True if a closing parenthesis ends a cast, meaning the parentheses hold only a
# type, so an operator after it is a prefix of the operand being cast
def closesCast(close):
    inner = []
    depth = 0
    lexeme = close.previous(True, True)
    while lexeme:
        if lexeme.text() == ')':
            depth += 1
        elif lexeme.text() == '(':
            if depth == 0:
                break
            depth -= 1
        inner.append(lexeme)
        lexeme = lexeme.previous(True, True)
    # The parenthesized type of sizeof is an operand, not a cast
    before = lexeme.previous(True, True) if lexeme else None
    if not inner or (before and before.text() in ('sizeof', '_Alignof', 'alignof')):
        return False
    named = False
    for lexeme in inner:
        ent = lexeme.ent()
        if lexeme.token() == 'Keyword' and lexeme.text() not in OPERAND_KEYWORDS | {'sizeof'}:
            named = True
        elif ent and ent.kind().check('Typedef, Type'):
            named = True
        elif lexeme.text() not in ('*', '&', '::'):
            return False
    return named


# An operator preceded by nothing that can end an operand is a prefix operator
def isPrefix(lexeme):
    return lexeme.token() == 'Operator' and not isBinary(lexeme)


def leftOperand(operator):
    precedence = Modules.C_OPERATOR_PRECEDENCES[operator.text()]
    lexemes = []
    depth = 0
    lexeme = operator.previous(True, True)
    while lexeme:
        text = lexeme.text()
        if text in (')', ']'):
            depth += 1
        elif text in ('(', '['):
            if depth == 0:
                break
            depth -= 1
        elif depth == 0:
            if text in (';', '{', '}', ',', ':', '?') or lexeme.token() == 'Preprocessor':
                break
            if lexeme.token() == 'Keyword' and text not in OPERAND_KEYWORDS and text != 'sizeof':
                break
            # The operators are left associative, so an operator of the same
            # precedence belongs to the left operand
            if (lexeme.token() == 'Operator' and not isPrefix(lexeme)
                    and Modules.C_OPERATOR_PRECEDENCES.get(text, 0) > precedence):
                break
        lexemes.append(lexeme)
        lexeme = lexeme.previous(True, True)
    lexemes.reverse()
    return lexemes


def rightOperand(operator):
    return operandAfter(operator, Modules.C_OPERATOR_PRECEDENCES[operator.text()])


# The operand following a lexeme, ending at an operator binding no tighter than
# the given precedence
def operandAfter(start, precedence):
    lexemes = []
    depth = 0
    angle = 0
    expecting = True
    lexeme = start.next(True, True)
    while lexeme:
        text = lexeme.text()
        if angle or (lexemes and Modules.cOpensTemplateArguments(lexemes + [lexeme], len(lexemes))):
            angle = Modules.cAngleDepth(angle, text)
        elif text in ('(', '['):
            depth += 1
        elif text in (')', ']'):
            if depth == 0:
                break
            depth -= 1
            expecting = depth > 0
        elif depth == 0:
            if text in (';', '{', '}', ',', ':', '?') or lexeme.token() == 'Preprocessor':
                break
            if lexeme.token() == 'Operator':
                if not expecting:
                    if Modules.C_OPERATOR_PRECEDENCES.get(text, 99) >= precedence:
                        break
                    # A postfix operator leaves the operand complete
                    expecting = text not in ('++', '--')
            elif lexeme.token() == 'Keyword' and text not in OPERAND_KEYWORDS and text != 'sizeof':
                if not (expecting and lexemes):
                    break
            else:
                expecting = False
        lexemes.append(lexeme)
        lexeme = lexeme.next(True, True)
    return lexemes


# The second and third operands of a conditional operator
def conditionalOperands(question):
    second = []
    depth = 0
    nested = 0
    lexeme = question.next(True, True)
    while lexeme:
        text = lexeme.text()
        if text in ('(', '[', '{'):
            depth += 1
        elif text in (')', ']', '}'):
            if depth == 0:
                return ([], [])
            depth -= 1
        elif depth == 0 and text == '?':
            nested += 1
        elif depth == 0 and text == ':':
            if nested == 0:
                break
            nested -= 1
        elif depth == 0 and text == ';':
            return ([], [])
        second.append(lexeme)
        lexeme = lexeme.next(True, True)
    if not lexeme:
        return ([], [])
    return (second, operandAfter(lexeme, Modules.C_OPERATOR_PRECEDENCES['?']))
