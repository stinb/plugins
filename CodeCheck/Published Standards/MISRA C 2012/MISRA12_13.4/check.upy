    return {
        'MISRA12_13.4': 'Published Standards/MISRA C 2012/' + """\
13.4 The result of an assignment operator should not be used""",
        'MISRA23_13.4': 'Published Standards/MISRA C 2023/' + """\
13.4 The result of an assignment operator should not be used""",
        'CPP_E085': 'All Checks/Language Specific/C and C++/Expressions/' + """\
The result of an assignment operator should not be used""",
        'MISRA25_13.4': 'Published Standards/MISRA C 2025/13.4 The result of an assignment operator should not be used',
        'MISRA23_8.18.2': 'Published Standards/MISRA C++ 2023/8.18.2 The result of an assignment operator should not be used',
    }[id]




