# The long description of the check
def detailed_description(id):
    desc = """\
<p><b>Amplification</b></p>
<p>This rule applies even if the expression containing the assignment operator
is not evaluated.</p>
<p><b>Rationale</b></p>
<p>The use of assignment operators, simple or compound, in combination with
other arithmetic operators is not recommended because:</p>
<ul>
<li>It can significantly impair the readability of the code;</li>
<li>It introduces additional side effects into a statement making it more
difficult to avoid the undefined behaviour covered by Rule 13.2.</li>
</ul>
<p><b>Example</b></p>
<pre><code language="C++">x = y; /* Compliant */
a[ x ] = a[ x = y ]; /* Non-compliant - the value of x = y
* is used */
/*
* Non-compliant - value of bool_var = false is used but
* bool_var == false was probably intended
*/
if ( bool_var = false )
{
}
/* Non-compliant even though bool_var = true isn't evaluated */
if ( ( 0u == 0u ) || ( bool_var = true ) )
{
}
/* Non-compliant - value of x = f() is used */
if ( ( x = f ( ) ) != 0 )
{
}
/* Non-compliant - value of b += c is used */
a[ b += c ] = a[ b ];

/* Non-compliant - values of c = 0 and b = c = 0 are used */
a = b = c = 0;</code></pre>
<p><b>See also</b></p>
<p>Rule 13.2</p>
"""
    return {
        'MISRA12_13.4': desc,
        'MISRA23_13.4': desc,
        'CPP_E085': desc,

        'MISRA23_8.18.2': """<p><b>Amplification</b></p>
<p>This rule applies to simple and compound assignments, built-in or
overloaded, even if they occur in an infeasible path. It does not apply to
assignments within an unevaluated operand.</p>
<p><b>Rationale</b></p>
<p>The use of assignment operators, simple or compound, in combination with
other arithmetic operators is not recommended because:</p>
<ul>
<li>It can significantly impair the readability of the code;</li>
<li>It introduces additional side effects into a statement, making it more
difficult to avoid the undefined behaviour covered by Rule 4.6.1.</li>
</ul>
<p><b>Developer's Notes</b></p>
<p>A declaration in the condition of an <code>if</code>, <code>while</code> or
<code>for</code> initializes rather than assigns, so
<code>if ( uint8_t i = y )</code> is not reported, as the rule requires.</p>
<p>Two forms are not reported. A compound assignment other than
<code>+=</code> or <code>-=</code> is not recognised, so
<code>a[ b *= c ] = a[ b ]</code> is missed; and the result of an overloaded
<code>operator=</code> used as a value is not seen, this check reading the
token stream rather than resolving the operator.</p>
<p><b>Example</b></p>
<pre><code language="C++">x = y;                       // Compliant
a[ x ] = a[ x = y ];         // Non-compliant - value of x = y is used

if ( bool_a = bool_b )       // Non-compliant - bool_a == bool_b was
{                            //                 probably intended
}

if ( uint8_t i = y )         // Rule does not apply - not an assignment
{
}

if ( ( x = f( ) ) != 0 )     // Non-compliant - value of x = f( ) is used
{
}

a[ b += c ] = a[ b ];        // Non-compliant - value of b += c is used
a = b = c = 0;               // Non-compliant - values of c = 0, b = c = 0
                             //                 are used</code></pre>
<p><b>See also</b></p>
<p>Rule 4.6.1</p>
""",
        'MISRA25_13.4': """<p><b>Amplification</b></p>
<p>This rule applies even if the expression containing the assignment operator is not evaluated.</p>
<p><b>Rationale</b></p>
<p>The use of assignment operators, simple or compound, in combination with other arithmetic operators is not recommended because:</p>
<ul>
<li>It can significantly impair the readability of the code;</li>
<li>It introduces additional side effects into a statement making it more difficult to avoid the undefined behaviour covered by Rule 13.2.</li>
</ul>
<p><b>Example</b></p>
<pre><code language="C">x = y;                            /* Compliant                          */
a[ x ] = a[ x = y ];             /* Non-compliant - the value of x = y
                                   * is used                            */

/*
 * Non-compliant - value of bool_var = false is used but
 * bool_var == false was probably intended
 */
if ( bool_var = false )
{
}

/* Non-compliant even though bool_var = true isn't evaluated            */
if ( ( 0u == 0u ) || ( bool_var = true ) )
{
}

/* Non-compliant - value of x = f() is used                            */
if ( ( x = f ( ) ) != 0 )
{
}

/* Non-compliant - value of b += c is used                             */
a[ b += c ] = a[ b ];

/* Non-compliant - values of c = 0 and b = c = 0 are used             */
a = b = c = 0;</code></pre>
""",
    }[id]

# Tests the type of file
def test_entity(file):
    return file.kind().check('file')

def test_global():
    return False

def test_language(language):
    return language == 'C++'

# C++ allows a declaration in the condition of an if, while or for. The rule
# does not apply to one: "if ( uint8_t i = y )" initializes rather than
# assigns.
def initializes_a_declaration(lexeme):
    previous = lexeme.previous(True, True)
    if not previous:
        return False

    ref = previous.ref()
    if not ref:
        return False

    # The reference at the declared name is an inverse kind, "C Definein".
    kind = ref.kind().longname()
    return 'Define' in kind or 'Declare' in kind


# The lexeme after an unevaluated operand, when this one starts such an
# operand. The rule does not apply to an assignment inside it.
def end_of_unevaluated(lexeme):
    if lexeme.text() not in ('sizeof', 'decltype', 'noexcept', 'typeid',
                             'alignof', '_Alignof'):
        return None

    opening = lexeme.next(True, True)
    if not opening or opening.text() != '(':
        return None

    close = Modules.findClose(opening)
    return close.next(True, True) if close else None


def check(check, file):
    if not file.lexer():
        return
    lexer = file.lexer()
    lexeme = lexer.first()
    l = ['if', '[', 'while', 'for', '=', '+=', '-=']
    assigns = ['=', '+=', '-=']
    while lexeme:
        lastLex = lexeme

        # The rule does not apply to an assignment in an unevaluated operand.
        jump = end_of_unevaluated(lexeme)
        if jump:
            lexeme = jump
            continue
        if lexeme.token() == 'Preprocessor':
            line = lexeme.line_begin()
            while lexeme and line == lexeme.line_begin():
                lastLex = lexeme
                lexeme = lexeme.next(True, True)
                if lexeme and lexeme.line_begin() != line and lastLex.text() == '\\':
                    line = lexeme.line_begin()

            if not lexeme:
                break
        if lexeme.text() in l:
            ok = True
            # Check if and while statements
            if lexeme.text() in ['if', 'while', '[']:
                if lexeme.text() != '[':
                    lexeme = lexeme.next(True, True)
                if lexeme and lexeme.text() in ['(', '[']:
                    close = Modules.findClose(lexeme)
                    while lexeme and close and not (lexeme.line_begin() == close.line_begin() and lexeme.column_begin() == close.column_begin()):
                        jump = end_of_unevaluated(lexeme)
                        if jump:
                            lexeme = jump
                            continue
                        if (lexeme.text() in assigns
                                and not initializes_a_declaration(lexeme)):
                            ok = False
                            break
                        lexeme = lexeme.next(True, True)

            # Check 2nd statement of for loop
            elif lexeme.text() == 'for':
                lexeme = lexeme.next(True, True)
                if lexeme and lexeme.text() == '(':
                    close = Modules.findClose(lexeme)
                    count = 0
                    while lexeme and close and not (lexeme.line_begin() == close.line_begin() and lexeme.column_begin() == close.column_begin()):
                        if lexeme.text() == ';':
                            count += 1
                            if count > 1:
                                break
                        if count == 1:
                            jump = end_of_unevaluated(lexeme)
                            if jump:
                                lexeme = jump
                                continue
                            if (lexeme.text() in assigns
                                    and not initializes_a_declaration(lexeme)):
                                ok = False
                                break
                        lexeme = lexeme.next(True, True)

            # Check after =
            elif lexeme.text() == '=':
                prevLex = lexeme.previous(True, True)
                lexeme = lexeme.next(True, True)
                if prevLex and prevLex.ent() and prevLex.ent().kind().check("Enumerator"):
                    continue
                # Stop at comma to avoid flagging designated initializers like {.x = 1, .y = 2}
                while lexeme and not lexeme.text() in [';', '{', '}', ',']:
                    jump = end_of_unevaluated(lexeme)
                    if jump:
                        lexeme = jump
                        continue
                    if (lexeme.text() in assigns
                            and not initializes_a_declaration(lexeme)):
                        ok = False
                        break
                    lexeme = lexeme.next(True, True)
                        
            
            if not ok:
                check.violation(file, file, lexeme.line_begin(), lexeme.column_begin(), ERR1)
        # If lexeme didn't change this iteration then get next lexeme
        if lexeme and lexeme.line_begin() == lastLex.line_begin() and lexeme.column_begin() == lastLex.column_begin():
            lexeme = lexeme.next(True, True)
