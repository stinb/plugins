            'Expressions',
        ],
    }.get(id)


# The long description of the check
def detailed_description(id):
    desc = """\
<p><b>Rationale</b></p>
<p>The rationale is described in the introduction on composite operators and
expressions (see Section8.1 0.3).</p>
<p>Casting to a wider type is not permitted as the result may vary between
implementations. Consider the following:</p>
<pre><code language="C++">( uint32_t ) ( u16a + u16b );</code></pre>
<p>On a 16-bit machine the addition will be performed in 16 bits with the result
wrapping modulo-2 before it is cast to 32 bits. However, on a 32-bit machine the
addition will take place in 32 bits and would preserve high-order bits that
would have been lost on a 16-bit machine.</p>
<p>Casting to a narrower type with the same essential type category is
acceptable as the explicit truncation of the result always leads to the same
loss of information.</p>
<p><b>Example</b></p>
<pre><code language="C++">( uint16_t ) ( u32a + u32b ) /* Compliant */
( uint16_t ) ( s32a + s32b ) /* Non -compliant - different essential
* type category */
( uint16_t ) s32a /* Compliant - s32a is not composite */
( uint32_t ) ( u16a + u16b ) /* Non-compliant - cast to wider
* essential type */</pre></code>
"""
    return {
        'MISRA12_10.8': desc,
        'MISRA23_10.8': desc,
        'CPP_E078': desc,

        'MISRA25_10.8': """<p><b>Rationale</b></p>
<p>The rationale is described in the introduction on <i>composite operators and expressions</i> (see Section 5.10.3).</p>
<p>Casting to a wider type is not permitted as the result may vary between implementations. Consider the following:</p>
<pre><code language="C">( uint32_t ) ( u16a + u16b );
</code></pre>
<p>On a 16-bit machine the addition will be performed in 16 bits with the result wrapping modulo-2^16 before it is cast to 32 bits. However, on a 32-bit machine the addition will take place in 32 bits and would preserve high-order bits that would have been lost on a 16-bit machine.</p>
<p>Casting to a narrower type with the same <i>essential type category</i> is acceptable as the explicit truncation of the result always leads to the same loss of information.</p>
<p><b>Exception</b></p>
<ol>
<li>An <i>essentially real floating</i> expression may be cast to an <i>essentially complex floating</i> type providing that the corresponding real type is not wider than the type of the expression.</li>
<li>An <i>essentially real complex</i> expression may be cast to <i>essentially real floating</i> type providing that type is not wider than the corresponding real type of the expression.</li>
</ol>
<p><b>Example</b></p>
<pre><code language="C">( uint16_t ) ( u32a + u32b )    /* Compliant                                      */
( uint16_t ) ( s32a + s32b )    /* Non-compliant - different essential type category */
( uint16_t ) s32a               /* Compliant     - s32a is not composite            */
( uint32_t ) ( u16a + u16b )    /* Non-compliant - cast to wider essential type      */
</code></pre>
""",
    }[id]

# Tests the type of file
def test_entity(file):
    return file.kind().check('file')

def test_global():
    return False

def test_language(language):
    return language == 'C++'

def check(check, file):
    lexer = file.lexer()
    if not lexer:
        return

    for ref in file.filerefs('Cast Use', 'Type'):
        lexeme = lexer.lexeme(ref.line(), ref.column())
        if not lexeme:
            continue

        closing = lexeme.next(True, True)
        # A pointer cast is outside the essential type model
        if not closing or closing.text() != ')':
            continue

        operand = castOperand(closing.next(True, True))
        if not operand or not Modules.cIsCompositeExpression(operand):
            continue

        cast = Modules.cEssentialType(ref.ent().name(), ref.ent())
        value = Modules.cEssentialTypeOfExpression(operand)
        if not cast or not value:
            continue
        if Modules.C_ESSENTIAL_POINTER in (cast[0], value[0]):
            continue

        # A cast to a narrower type of the same category is permitted
        if cast[0] == value[0]:
            if cast[1] is None or value[1] is None or cast[1] <= value[1]:
                continue

        check.violation(ref.ent(), file, ref.line(), ref.column(), ERR1)


# The lexemes of the expression a cast applies to. A cast binds tighter than any
# binary operator, so it covers a unary expression and no more.
def castOperand(lexeme):
    lexemes = []

    # Whatever the cast applies to may be reached through prefix operators
    while lexeme and lexeme.text() in ('~', '!', '-', '+', '*', '&', '++', '--'):
        lexemes.append(lexeme)
        lexeme = lexeme.next(True, True)

    if not lexeme:
        return []

    # Then a single value, which a group encloses in full
    if lexeme.text() == '(':
        lexemes += group(lexeme)
    elif lexeme.token() in ('Identifier', 'Literal', 'String', 'Keyword'):
        lexemes.append(lexeme)
    else:
        return []

    # Then whatever a call, a subscript or a member access adds to it
    lexeme = lexemes[-1].next(True, True)
    while lexeme:
        if lexeme.text() in ('(', '['):
            lexemes += group(lexeme)
        elif lexeme.text() in ('.', '->'):
            lexemes.append(lexeme)
            lexeme = lexeme.next(True, True)
            if not lexeme:
                break
            lexemes.append(lexeme)
        elif lexeme.text() in ('++', '--'):
            lexemes.append(lexeme)
        else:
            break
        lexeme = lexemes[-1].next(True, True)

    return lexemes


# The lexemes of a group, from its opening bracket through the one that closes it
def group(opening):
    close = Modules.findClose(opening)
    if not close:
        return []

    lexemes = []
    lexeme = opening
    while lexeme:
        lexemes.append(lexeme)
        if (lexeme.line_begin() == close.line_begin()
                and lexeme.column_begin() == close.column_begin()):
            break
        lexeme = lexeme.next(True, True)

    return lexemes
