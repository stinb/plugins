import Modules

ERR1 = 'Composite expression of %1 type cast to %2 type, a different essential type category'
ERR2 = 'Composite expression of %1 type cast to %2 type, which is wider'


# The ID for the check
def ids():
    return ('MISRA12_10.8', 'MISRA23_10.8', 'CPP_E078',
               'MISRA25_10.8'
    )

# The short name of the check
def name(id):
    return {
        'MISRA12_10.8': 'Published Standards/MISRA C 2012/' + """\
10.8 The value of a composite expression shall not be cast to a different \
essential type category or a wider essential type""",
        'MISRA23_10.8': 'Published Standards/MISRA C 2023/' + """\
10.8 The value of a composite expression shall not be cast to a different \
essential type category or a wider essential type""",
        'CPP_E078': 'All Checks/Language Specific/C and C++/Expressions/' + """\
The value of a composite expression shall not be cast to a different essential \
type category or a wider essential type""",
        'MISRA25_10.8': 'Published Standards/MISRA C 2025/10.8 The value of a composite expression shall not be cast to a different essential type category or a wider essential type',
    }[id]




def tags(id):
    return {
        'MISRA12_10.8': [
            'Language: C',
            'Language: C++',
            'Standard: MISRA C 2012',
            'Category: Required',
            'Expressions',
        ],
        'MISRA23_10.8': [
            'Language: C',
            'Language: C++',
            'Standard: MISRA C 2023',
            'Category: Required',
            'Expressions',
        ],
        'CPP_E078': [
            'Language: C',
            'Language: C++',
            'Expressions',
        ],
        'MISRA25_10.8': [
            'Language: C',
            'Standard: MISRA C 2025',
            'Category: Required',
            'Expressions',
        ],
    }.get(id)


# The long description of the check
def detailed_description(id):
    desc = """\
<p><b>Rationale</b></p>
<p>The rationale is described in the introduction on composite operators and
expressions (see Section8.1 0.3).</p>
<p>Casting to a wider type is not permitted as the result may vary between
implementations. Consider the following:</p>
<pre><code language="C++">( uint32_t ) ( u16a + u16b );</code></pre>
<p>On a 16-bit machine the addition will be performed in 16 bits with the result
wrapping modulo-2 before it is cast to 32 bits. However, on a 32-bit machine the
addition will take place in 32 bits and would preserve high-order bits that
would have been lost on a 16-bit machine.</p>
<p>Casting to a narrower type with the same essential type category is
acceptable as the explicit truncation of the result always leads to the same
loss of information.</p>
<p><b>Example</b></p>
<pre><code language="C++">( uint16_t ) ( u32a + u32b ) /* Compliant */
( uint16_t ) ( s32a + s32b ) /* Non -compliant - different essential
* type category */
( uint16_t ) s32a /* Compliant - s32a is not composite */
( uint32_t ) ( u16a + u16b ) /* Non-compliant - cast to wider
* essential type */</pre></code>
"""
    return {
        'MISRA12_10.8': desc,
        'MISRA23_10.8': desc,
        'CPP_E078': desc,

        'MISRA25_10.8': """<p><b>Rationale</b></p>
<p>The rationale is described in the introduction on <i>composite operators and expressions</i> (see Section 5.10.3).</p>
<p>Casting to a wider type is not permitted as the result may vary between implementations. Consider the following:</p>
<pre><code language="C">( uint32_t ) ( u16a + u16b );
</code></pre>
<p>On a 16-bit machine the addition will be performed in 16 bits with the result wrapping modulo-2^16 before it is cast to 32 bits. However, on a 32-bit machine the addition will take place in 32 bits and would preserve high-order bits that would have been lost on a 16-bit machine.</p>
<p>Casting to a narrower type with the same <i>essential type category</i> is acceptable as the explicit truncation of the result always leads to the same loss of information.</p>
<p><b>Exception</b></p>
<ol>
<li>An <i>essentially real floating</i> expression may be cast to an <i>essentially complex floating</i> type providing that the corresponding real type is not wider than the type of the expression.</li>
<li>An <i>essentially real complex</i> expression may be cast to <i>essentially real floating</i> type providing that type is not wider than the corresponding real type of the expression.</li>
</ol>
<p><b>Example</b></p>
<pre><code language="C">( uint16_t ) ( u32a + u32b )    /* Compliant                                      */
( uint16_t ) ( s32a + s32b )    /* Non-compliant - different essential type category */
( uint16_t ) s32a               /* Compliant     - s32a is not composite            */
( uint32_t ) ( u16a + u16b )    /* Non-compliant - cast to wider essential type      */
</code></pre>
""",
    }[id]

# Tests the type of file
def test_entity(file):
    return file.kind().check('file')

def test_global():
    return False

def test_language(language):
    return language == 'C++'

def check(check, file):
    lexer = file.lexer()
    if not lexer:
        return

    # A cast through a type macro or a qualified name is found by its reference
    castRefs = {(ref.line(), ref.column()): ref for ref in file.filerefs('Cast Use', 'Type')}

    directive = False
    previous = None
    for lexeme in lexer.lexemes():
        token = lexeme.token()
        if token == 'Newline':
            # A directive continues past a line ending in a backslash
            directive = directive and bool(previous) and previous.text().endswith('\\')
            continue
        if token == 'Preprocessor' and lexeme.text() == '#':
            directive = True
        if token not in ('Whitespace', 'Comment'):
            previous = lexeme
        if directive or lexeme.text() != '(' or lexeme.inactive():
            continue

        typeLexemes, ref = castType(lexeme, castRefs)
        if not typeLexemes:
            continue
        closing = typeLexemes[-1].next(True, True)
        operand = castOperand(closing.next(True, True))
        if not operand or not Modules.cIsCompositeExpression(operand):
            continue

        if ref:
            # A pointer cast is outside the essential type model
            if any(l.text() == '*' for l in typeLexemes):
                continue
            cast = Modules.cEssentialType(ref.ent().name(), ref.ent())
        else:
            cast = Modules.cLeadingCast([lexeme] + typeLexemes + [closing] + operand)
        value = Modules.cEssentialTypeOfExpression(operand)
        if not cast or not value:
            continue
        if Modules.C_ESSENTIAL_POINTER in (cast[0], value[0]):
            continue

        # A cast to a narrower type of the same category is permitted
        if cast[0] != value[0]:
            error = ERR1
        elif cast[1] is None or value[1] is None or cast[1] <= value[1]:
            continue
        else:
            error = ERR2

        if ref:
            typeEnt, line, column = ref.ent(), ref.line(), ref.column()
        else:
            anchor = next((l for l in typeLexemes if l.ent()), typeLexemes[0])
            typeEnt, line, column = anchor.ent(), anchor.line_begin(), anchor.column_begin()
        check.violation(typeEnt, file, line, column, error,
                        Modules.cDescribeEssentialType(value),
                        Modules.cDescribeEssentialType(cast))


# The type lexemes of a cast opening at this parenthesis and the cast reference
# among them, or (None, None). The parentheses must hold only a type name, or a
# name the cast reference lands on, and must not be those of a call, of sizeof,
# or of a compound literal.
def castType(opening, castRefs):
    before = opening.previous(True, True)
    if before and (before.token() == 'Identifier' or before.text() in (')', ']')
            or before.text() in ('sizeof', '_Alignof', 'alignof', '_Generic')):
        return (None, None)

    inner = []
    lexeme = opening.next(True, True)
    while lexeme and lexeme.text() != ')':
        if lexeme.text() in ('(', '[', ';', '{', '}'):
            return (None, None)
        inner.append(lexeme)
        lexeme = lexeme.next(True, True)
    if not lexeme or not inner:
        return (None, None)
    ref = next((castRefs[(l.line_begin(), l.column_begin())] for l in inner
                if (l.line_begin(), l.column_begin()) in castRefs), None)
    if not ref and not Modules.cNamesType(inner):
        return (None, None)

    after = lexeme.next(True, True)
    if not after or after.text() == '{':
        return (None, None)
    if after.token() not in ('Identifier', 'Literal', 'String', 'Keyword') and after.text() not in (
            '(', '~', '!', '-', '+', '*', '&', '++', '--'):
        return (None, None)
    return (inner, ref)


# The lexemes of the expression a cast applies to. A cast binds tighter than any
# binary operator, so it covers a unary expression and no more.
def castOperand(lexeme):
    lexemes = []

    # Whatever the cast applies to may be reached through prefix operators
    while lexeme and lexeme.text() in ('~', '!', '-', '+', '*', '&', '++', '--'):
        lexemes.append(lexeme)
        lexeme = lexeme.next(True, True)

    if not lexeme:
        return []

    # Then a single value, which a group encloses in full
    if lexeme.text() == '(':
        lexemes += group(lexeme)
    elif lexeme.token() in ('Identifier', 'Literal', 'String', 'Keyword'):
        lexemes.append(lexeme)
    else:
        return []

    # Then whatever a call, a subscript or a member access adds to it
    lexeme = lexemes[-1].next(True, True)
    while lexeme:
        if lexeme.text() in ('(', '['):
            lexemes += group(lexeme)
        elif lexeme.text() in ('.', '->'):
            lexemes.append(lexeme)
            lexeme = lexeme.next(True, True)
            if not lexeme:
                break
            lexemes.append(lexeme)
        elif lexeme.text() in ('++', '--'):
            lexemes.append(lexeme)
        else:
            break
        lexeme = lexemes[-1].next(True, True)

    return lexemes


# The lexemes of a group, from its opening bracket through the one that closes it
def group(opening):
    close = Modules.findClose(opening)
    if not close:
        return []

    lexemes = []
    lexeme = opening
    while lexeme:
        lexemes.append(lexeme)
        if (lexeme.line_begin() == close.line_begin()
                and lexeme.column_begin() == close.column_begin()):
            break
        lexeme = lexeme.next(True, True)

    return lexemes
