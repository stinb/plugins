import re

from Modules import findClose, fortranCallee, fortranDummy, fortranHasBareSave, fortranStatementEnd, refInNode

ERR1 = 'Pointer "%1" may be used before it is associated or nullified'

SKIP_TOKENS = ('Whitespace', 'Newline', 'Comment', 'Continuation')
ASSOCIATING_STATEMENTS = ('allocate', 'nullify')


def ids():
    return ('FORTRAN_P001',)


def name(id):
    return 'All Checks/Language Specific/Fortran/Pointers/Local pointers shall be associated or nullified before use'


def tags(id):
    return [
        'Language: Fortran',
        'Pointers',
    ]


def detailed_description(id):
    return '''\
<p>A local pointer without a default initialization shall be associated,
allocated or nullified on every path before it is used.</p>

<p><b>Rationale</b></p>
<p>A local pointer starts with an undefined association status. Even
<code>associated</code> can't be used to test it: the result is undefined,
and the program may crash or behave differently on each compiler.</p>

<p><b>Example</b></p>
<pre><code language="Fortran">subroutine sample()
  real, pointer :: x
  real, target :: y

  y = 0.
  if (associated(x)) print *, x  ! Noncompliant: x is undefined
  x => y
  if (associated(x)) print *, x  ! Compliant
end subroutine
</code></pre>

<p><b>Developer's Notes</b></p>
<p>A pointer is associated by pointer assignment, <code>allocate</code>,
<code>nullify</code>, or by passing it to a procedure that may associate it:
one whose dummy argument is a pointer without <code>intent(in)</code>, or one
whose dummy argument can't be found, such as an external, generic or
type-bound procedure, or <code>c_f_pointer</code>. Any other reference is a
use, including passing it to an intrinsic function such as
<code>associated</code>, but not the mold of <code>null</code>. Paths are
followed through the control flow of the procedure, without evaluating
conditions. Pointers that are initialized in their declaration, saved, dummy
arguments, Cray pointers, or declared in a procedure with a <code>save</code>
statement that has no list are not checked.</p>
'''


def test_entity(file):
    return True


def test_language(language):
    return language == 'Fortran'


def check(check, file):
    lexer = None
    graphs = {}
    savesAll = {}
    for ref in file.filerefs('Define', 'Local Variable'):
        ent = ref.ent()
        typeText = ent.type() or ''
        if not re.search(r'\bPOINTER\b', typeText, re.I) or re.search(r'\bSAVE\b', typeText, re.I):
            continue
        if ent.refs('Setby Init'):
            continue
        proc = ref.scope()
        # Same-named procedures in other files share one entity
        if not any(defin.file() == file for defin in proc.refs('Definein')):
            continue

        if not lexer:
            lexer = file.lexer(lookup_ents=True)
        if isCrayPointer(ent, file, lexer):
            continue
        if proc not in savesAll:
            savesAll[proc] = fortranHasBareSave(proc, file, lexer)
        if savesAll[proc]:
            continue

        if proc not in graphs:
            graphs[proc] = proc.control_flow_graph()
        cfg = graphs[proc]
        if not cfg:
            continue
        nodes = cfg.nodes()

        # The first reference in each node decides whether it associates or uses
        firsts = {}
        actions = {}
        unplaced = False
        for use in sorted(ent.refs('Setby ~Init, Useby, Modifyby'), key=lambda r: (r.line(), r.column())):
            if use.file() != file:
                continue
            node = next((node for node in nodes if refInNode(use, node)), None)
            if not node:
                unplaced = True
                break
            if node in firsts:
                continue
            action = classify(lexer.lexeme(use.line(), use.column()))
            if action:
                firsts[node] = use
                actions[node] = action == 'associate'
        if unplaced or not firsts:
            continue

        for node in firstUses(cfg.start(), actions):
            use = firsts[node]
            check.violation(ent, file, use.line(), use.column(), ERR1, ent.name())


def firstUses(start, actions):
    # Uses reached on some path from the start without an association before them
    found = []
    stack = list(start.children())
    seen = set()
    while stack:
        node = stack.pop()
        if node in seen:
            continue
        seen.add(node)
        if node in actions:
            if not actions[node]:
                found.append(node)
            continue
        stack.extend(node.children())
    return sorted(found, key=lambda node: (node.line_begin(), node.column_begin()))


def classify(lex):
    # 'associate', 'use', or None for a reference that is neither
    if not lex:
        return 'use'
    after = nextCode(lex)
    shaped = after and after.text() == '('
    if shaped:
        after = nextCode(findClose(after))  # Bounds remapping, allocate shape or element
    if after and after.text() == '=>':
        return 'associate'

    # An argument of allocate, nullify or a procedure call
    if not after or after.text() not in (',', ')'):
        return 'use'
    keyword = None
    before = prevCode(lex)
    if before and before.text() == '=':
        name = prevCode(before)
        if not name or name.token() != 'Identifier':
            return 'use'
        keyword = name.text().lower()
        before = prevCode(name)
    if not before or before.text() not in ('(', ',', '::'):
        return 'use'
    target = fortranCallee(before)
    if not target:
        return 'use'
    callee, position = target
    if callee.text().lower() in ASSOCIATING_STATEMENTS:
        return 'associate'
    if shaped:
        return 'use'
    ent = callee.ent()
    call = callee.ref()
    if ent and ent.kind().check('Intrinsic Function'):
        # The mold of null may have any association status
        return None if ent.name().lower() == 'null' else 'use'
    if not ent or not call or not call.kind().check('Callby') or not ent.kind().check('Subroutine, Function'):
        return 'use'

    # Only a pointer dummy that isn't intent(in) can change the association
    dummy = fortranDummy(ent, callee, keyword, position)
    if dummy and (not re.search(r'\bPOINTER\b', dummy.type() or '', re.I)
                  or re.search(r'\bINTENT\s*\(\s*IN\s*\)', dummy.type() or '', re.I)):
        return 'use'
    return 'associate'


def isCrayPointer(ent, file, lexer):
    # Named in a pointer (pointer, pointee) statement
    for ref in ent.refs('Definein, Declarein'):
        if ref.file() != file:
            continue
        lex = lexer.lexeme(ref.line(), ref.column())
        first = None
        while lex and not fortranStatementEnd(lex):
            first = lex
            lex = prevCode(lex)
        after = nextCode(first) if first else None
        if first and first.text().lower() == 'pointer' and after and after.text() == '(':
            return True
    return False


def nextCode(lex):
    if not lex:
        return None
    lex = lex.next()
    while lex and lex.token() in SKIP_TOKENS:
        lex = lex.next()
    return lex


def prevCode(lex):
    lex = lex.previous()
    while lex and lex.token() in SKIP_TOKENS:
        lex = lex.previous()
    return lex
