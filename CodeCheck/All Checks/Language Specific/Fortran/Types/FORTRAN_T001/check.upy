ERR1 = 'Type "DOUBLE %1" is used'

SKIP_TOKENS = ('Whitespace', 'Newline', 'Comment', 'Continuation')


def ids():
    return ('FORTRAN_T001',)


def name(id):
    return 'All Checks/Language Specific/Fortran/Types/DOUBLE PRECISION and DOUBLE COMPLEX shall not be used'


def tags(id):
    return [
        'Language: Fortran',
        'Types',
    ]


def detailed_description(id):
    return '''\
<p>The types <code>DOUBLE PRECISION</code> and <code>DOUBLE COMPLEX</code>
shall not be used. Use <code>REAL</code> or <code>COMPLEX</code> with an
explicit kind instead.</p>

<p><b>Rationale</b></p>
<p>The size of double precision depends on the compiler and its options. For
example, the NAG compiler with <code>-r8</code> or <code>-double</code> makes
<code>DOUBLE PRECISION</code> 16 bytes, while <code>REAL(8)</code> stays 8
bytes. Code that mixes them, or passes one where the other is expected, may
behave differently on each compiler. A kind parameter states the precision on
every compiler.</p>

<p><b>Example</b></p>
<pre><code language="Fortran">integer, parameter :: dp = selected_real_kind(15)
double precision :: x  ! Noncompliant
real(dp) :: y          ! Compliant
</code></pre>

<p><b>Developer's Notes</b></p>
<p>Every use of the type is reported, including <code>IMPLICIT</code>
statements, function results, <code>ALLOCATE</code> type specifications and
<code>TYPE IS</code> guards. Intrinsic functions that return double precision,
such as <code>DBLE</code>, and constants with a <code>D</code> exponent are not
reported.</p>
'''


def test_entity(file):
    return True


def test_language(language):
    return language == 'Fortran'


def check(check, file):
    lexer = file.lexer(lookup_ents=False)
    if not lexer:
        return

    double = None
    for lex in lexer:
        if lex.token() in SKIP_TOKENS:
            continue
        # In fixed form the rest of the statement may lex as one identifier,
        # such as COMPLEXZ. A variable named double is never followed by a name.
        word = lex.text().lower()
        if double:
            second = next((kind for kind in ('precision', 'complex') if word.startswith(kind)), None)
            if second:
                check.violation(file, file, double.line_begin(), double.column_begin(), ERR1, second.upper())
        double = lex if word == 'double' and lex.token() in ('Keyword', 'Identifier') else None
