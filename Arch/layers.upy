import und_lib.graph_algorithms as graph_algorithms
import understand

def name():
  return "Dependency Layers"

def description():
  return '''Group files by layer in dependency graph
    <p>From the file dependency graph, group files into layers. Files that no
    other file depends on are in the highest layer, and every other file is one
    layer below the lowest file that depends on it. Strongly connected
    components form subgroups within a layer.</p>
  '''

def tags():
  return [
    'Language: Any',
    'Dependencies',
    'Cycles',
  ]

def build(arch, db):
  files = db.files()
  if not files:
    return

  allowed = set(files)

  components, condensed = graph_algorithms.sccList(lambda file: allowed.intersection(file.depends().keys()), files, True)
  layers = graph_algorithms.layers(condensed.get, range(len(components) - 1, -1, -1))

  for layer, nodes in enumerate(layers):
    cycleId = 0
    for comp in sorted((components[idx] for idx in nodes), key=lambda c: (-len(c), min(f.longname() for f in c))):
      compSize = len(comp)
      cycleName = ""
      if compSize > 1:
        cycleName = '/Cycle {:03d}'.format(cycleId)
        cycleId += 1
      for file in comp:
        arch.map(file, 'Layer {:03d}'.format(layer) + cycleName)

