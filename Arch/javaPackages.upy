import und_lib.kind_util as kind_util

def name():
  return "Java Packages"

def description():
  return '''Group Java files by package.

  <p>Each package is a top-level architecture named by the package's full
  name, such as "org.example.util", with no nesting for parent packages.
  Standard library files are excluded. Files in the default package are added
  directly to the root.</p>
'''

def tags():
  return [
    'Language: Java',
  ]

def test_global(db):
  return "Java" in db.language()

def build(arch, db):
  for file in db.ents("java file ~unknown ~unresolved"):
    if arch.is_aborted():
      return
    if kind_util.is_standard(file):
      continue
    package = ""
    for ref in file.refs("java define", "java package", True):
      package = ref.ent().longname()
      break
    arch.map(file, package)
