import und_lib.distinct_names as distinct_names
import und_lib.graph_algorithms as graph_algorithms
import und_lib.kind_util as kind_util
import understand

def name():
  return "Connected File Groups"

def description():
  return '''Group files that are connected by dependencies
    <p>From the file dependency graph, group files linked by dependencies in
    either direction. No dependencies cross between groups. In graph terms, the
    groups are the weakly connected components of the file dependency graph.
    Companion files, such as a header and its source file, are only in the
    same group if dependencies connect them. A group with at least half of the
    files is named Main Group. Each other group is named after its hub, the
    file the most other files in the group depend on, with files tied for the
    most joined by " + ", up to three. Files with no dependencies to or from
    other files are grouped together under Isolated Files.</p>
    <p>The <a href="und://plugin/metric/CountFileGroupsDisconnected">Disconnected File Groups</a>
    and <a href="und://plugin/metric/PercentFilesInLargestGroup">Percent of Files in Largest Connected Group</a>
    metrics summarize these groups.</p>
  '''

def tags():
  return [
    'Language: Any',
    'Dependencies',
  ]

def build(arch, db):
  files = [file for file in db.files() if not file.kind().check("unparsed") and not kind_util.is_standard(file)]
  if not files:
    return

  allowed = set(files)
  successors = lambda file: allowed.intersection(file.depends().keys())

  groups = graph_algorithms.disjointParts(successors, files, isAborted=arch.is_aborted)
  if arch.is_aborted():
    return
  connected = [sorted(group, key=lambda f: f.longname()) for group in groups if len(group) > 1]
  connected.sort(key=lambda g: (-len(g), g[0].longname()))

  # A hub doesn't describe a group that is most of the project
  if connected and len(connected[0]) * 2 >= len(files):
    for file in connected[0]:
      arch.map(file, 'Main Group')
    connected = connected[1:]

  hubs = []
  for group in connected:
    counts = graph_algorithms.incoming(successors, group, isAborted=arch.is_aborted)
    if arch.is_aborted():
      return
    top = max(counts.values())
    hubs.append([file for file, count in counts.items() if count == top])

  for group, groupName in zip(connected, distinct_names.distinct_names(hubs)):
    for file in group:
      arch.map(file, groupName)

  for group in groups:
    if len(group) == 1:
      arch.map(next(iter(group)), 'Isolated Files')
