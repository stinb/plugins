import und_lib.kind_util as kind_util
import und_lib.reports.metrics_table as metricreports
import understand


def name():
  return "Architecture Metrics CSV"

def description():
  return '''<p>Display metrics for architectures</p>
  <p>Create a table with each metric as a column and each architecture as a row. </p>
  <br><img src=".doc/architecture_metrics.png"/>
  '''

def tags():
  return [
    'Target: Architectures',
    'Target: Project',
    'Language: Any',
    'Metrics IReport',
  ]

def is_enabled_by_default():
  return True

def test_global(db):
  return True

def test_architecture(arch):
  return len(arch.children()) > 0

def support_abort():
  return True

def init(report, target):
  report.options().radio_horiz("metrics", "Metrics", ["Summary", "All"], "Summary")



def generate(report, target, page):
  is_summary = report.options().lookup("metrics") == "Summary"
  metrics = []
  names = dict()
  for metric in understand.Metric.list(db=report.db()):
    tags = metric.tags()
    if not "Target: Architectures" in tags:
      continue
    if is_summary and not "Project Summary" in tags:
      continue
    metrics.append(metric.id())
    names[metric.id()] = metric.name()

  archs = []
  def allChildren(arch):
    for child in arch.children():
      archs.append(child)
      allChildren(child)

  if isinstance(target, understand.Db):
    archs = target.root_archs()
    if len(archs) == 1:
      allChildren(archs[0])
  else:
    allChildren(target)

  metricreports.metricsTable(report, metrics, archs, names=names, archLink=False, archnameformat="long")
