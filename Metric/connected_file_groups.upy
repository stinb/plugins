import und_lib.kind_util as kind_util
import und_lib.graph_algorithms as graph_algorithms
import understand

def ids():
  return ["CountFileGroupsDisconnected", "PercentFilesInLargestGroup"]

def name(id):
  if id == "CountFileGroupsDisconnected":
    return "Disconnected File Groups"
  if id == "PercentFilesInLargestGroup":
    return "Percent of Files in Largest Connected Group"

def description(id):
  common = '''<p>A connected file group is a set of files linked by dependencies
  in either direction: a file belongs to a group if it depends on a file in the
  group or a file in the group depends on it. No dependencies cross between
  groups. In graph terms, the groups are the weakly connected components of the
  file dependency graph. Each file with no dependencies to or from other files
  is a group by itself.</p>

  <p>For an architecture, only dependencies between files inside the
  architecture count.</p>

  <p>To see the groups, use the <a href="und://plugin/arch/Connected%20File%20Groups">
  Connected File Groups</a> architecture.</p>
  '''
  example = '''<p>For example, consider a project with three files where A depends on B and
  C has no dependencies.</p>
  <br>
  <img src=".doc/connected_file_groups.svg"/>
  '''
  if id == "CountFileGroupsDisconnected":
    return '''<p>The number of groups of files with no dependencies between
    groups.</p>
    ''' + common + '''
    <p>A value of 1 means every file is connected to the rest. Large values
    usually come from isolated files, such as test fixtures, examples or
    unused code, or from independent subprojects analyzed together.</p>
    ''' + example + '''
    <p>A and B form one group and C forms its own group, so the number of
    disconnected file groups is 2.</p>'''
  if id == "PercentFilesInLargestGroup":
    return '''<p>The percentage of files in the largest group of files
    connected by dependencies.</p>
    ''' + common + '''
    <p>A value of 100 means every file is connected to the rest. Low values
    mean the project or architecture is made of independent parts, so
    dependency-based metrics describe several separate systems at once.</p>
    ''' + example + '''
      <p>There are 2 disconnected file groups: A and B, and C by itself. The
    largest group has 2 of the 3 files, so the percent of files in the largest
    connected group is 66.7.</p>'''

def tags(id):
  return [
    'Category: Coupling',
    'Solution: Project Quality',
    'Language: Any',
    'Dependencies',
    'Target: Architectures',
    'Target: Project',
  ]

def test_available(metric, entkindstr):
  if entkindstr:
    return False # not available for entities

  return True

def test_architecture(metric, arch):
  return kind_util.can_contain_files(arch)

def test_global(metric, db):
  return kind_util.can_contain_files(db)

def value(metric, target):
  files = kind_util.list_by_kind(target, "file ~unknown ~unresolved ~unparsed", expand_files=False, exclude_standard=True)
  if not files:
    return 0

  allowed = set(files)
  successorsFunc = lambda file: allowed.intersection(file.depends().keys())
  groups = graph_algorithms.disjointParts(successorsFunc, files, isAborted=metric.is_aborted)

  if metric.is_aborted():
    return

  if metric.id() == "CountFileGroupsDisconnected":
    return len(groups)
  return max(len(group) for group in groups) / len(allowed) * 100
